       dataKey=\"studentScore\"\n            name=\"studentScore\"\n            stroke=\"#1E3A8A\"\n            strokeWidth={2.5}\n            dot={{ r: 4, fill: \'#1E3A8A\', strokeWidth: 1 }}\n            activeDot={{ r: 6 }}\n          />\n          <Line\n            type=\"monotone\"\n            dataKey=\"classAverage\"\n            name=\"classAverage\"\n            stroke=\"#0D9488\"\n            strokeWidth={2}\n            strokeDasharray=\"4 4\"\n            dot={{ r: 3, fill: \'#0D9488\' }}\n          />\n        </LineChart>\n      </ResponsiveContainer>\n    </div>\n  );\n};\n"
        path {
