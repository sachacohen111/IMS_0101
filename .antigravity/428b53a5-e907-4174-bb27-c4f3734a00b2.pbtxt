              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const otherCredits = allFin.filter(x => x.type === \'Credit\' && x.category !== \'Student fees\').reduce((a, b) => a + b.amount, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
