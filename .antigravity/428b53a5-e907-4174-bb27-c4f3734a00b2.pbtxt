              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            <td className=\"py-1.5 font-mono text-emerald-600\">{Math.max(...scores)}</td>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            <td className=\"py-1.5 font-mono text-rose-600\">{Math.min(...scores)}</td>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
