  planner_response {
    thinking: "**Defining App State Context**\n\nI\'m now focusing on constructing the React context, `/src/context/IMSContext.tsx`, which will hold the application\'s interactive state. Specifically, I\'m working to incorporate these key elements: the active user\'s role (SUPER_ADMIN, ADMIN, TEACHER, STUDENT, or PARENT), the currently active user, a dark mode toggle, and the mobile view modal state.\n\n\n**Enumerating Core State Collections**\n\nI\'m now identifying the essential data collections. These will encompass institute details, user profiles, teacher and student data, batch information, course catalogs, subject listings, timetables, attendance records, tests, test results, homework assignments, homework submissions, fee invoices, performance alerts, improvement plans, student remarks, notices, badges, and audit logs. This forms the foundation of the state structure.\n\n\n"
    tool_calls {
      id: "call_644472"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { createContext, useContext, useState, useMemo } from \'react\';\\nimport {\\n  Role,\\n  Institute,\\n  User,\\n  TeacherProfile,\\n  StudentProfile,\\n  ParentProfile,\\n  Course,\\n  Subject,\\n  Batch,\\n  TimetableSlot,\\n  AttendanceRecord,\\n  Test,\\n  TestResult,\\n  Homework,\\n  HomeworkSubmission,\\n  FeeInvoice,\\n  PerformanceAlert,\\n  ImprovementPlan,\\n  StudentRemark,\\n  Notice,\\n  Badge,\\n  AuditLog\\n} from \'../types/ims\';\\nimport {\\n  mockInstitute,\\n  mockUsers,\\n  mockTeachers,\\n  mockStudents,\\n  mockParents,\\n  mockCourses,\\n  mockSubjects,\\n  mockBatches,\\n  mockTimetable,\\n  initialAttendanceRecords,\\n  mockTests,\\n  mockTestResults,\\n  mockHomeworks,\\n  mockHomeworkSubmissions,\\n  mockFeeInvoices,\\n  mockPerformanceAlerts,\\n  mockImprovementPlans,\\n  mockStudentRemarks,\\n  mockNotices,\\n  mockBadges,\\n  mockAuditLogs\\n} from \'../data/mockData\';\\nimport { computeStudentDiagnostics, StudentDiagnosticResult } from \'../services/analyticsEngine\';\\n\\ninterface IMSContextType {\\n  role: Role;\\n  setRole: (role: Role) => void;\\n  currentUser: User;\\n  switchUser: (userId: string) => void;\\n  isDarkMode: boolean;\\n  toggleDarkMode: () => void;\\n  isMobilePreviewOpen: boolean;\\n  setMobilePreviewOpen: (open: boolean) => void;\\n\\n  // Data\\n  institute: Institute;\\n  users: User[];\\n  teachers: TeacherProfile[];\\n  students: StudentProfile[];\\n  parents: ParentProfile[];\\n  courses: Course[];\\n  subjects: Subject[];\\n  batches: Batch[];\\n  timetable: TimetableSlot[];\\n  attendanceRecords: AttendanceRecord[];\\n  tests: Test[];\\n  testResults: TestResult[];\\n  homeworks: Homework[];\\n  homeworkSubmissions: HomeworkSubmission[];\\n  feeInvoices: FeeInvoice[];\\n  performanceAlerts: PerformanceAlert[];\\n  improvementPlans: ImprovementPlan[];\\n  studentRemarks: StudentRemark[];\\n  notices: Notice[];\\n  badges: Badge[];\\n  auditLogs: AuditLog[];\\n\\n  // Helpers\\n  getStudentUser: (studentProfileId: string) => User | undefined;\\n  getTeacherUser: (teacherProfileId: string) => User | undefined;\\n  getBatchStudents: (batchId: string) => Array<{ student: StudentProfile; user: User }>;\\n  getStudentDiagnostic: (studentId: string) => StudentDiagnosticResult;\\n\\n  // Actions\\n  markBatchAttendance: (\\n    batchId: string,\\n    date: string,\\n    records: Record<string, \'PRESENT\' | \'ABSENT\' | \'LATE\' | \'EXCUSED\'>,\\n    remarks?: Record<string, string>\\n  ) => void;\\n  createTest: (\\n    test: Omit<Test, \'id\'>,\\n    initialMarks?: Record<string, number>\\n  ) => void;\\n  saveTestMarks: (\\n    testId: string,\\n    results: Array<{ studentId: string; marksObtained: number; remarks?: string }>\\n  ) => void;\\n  createHomework: (hw: Omit<Homework, \'id\' | \'totalSubmissions\'>) => void;\\n  submitHomework: (homeworkId: string, studentId: string, fileName: string) => void;\\n  gradeHomework: (submissionId: string, grade: string, score: number, feedback: string) => void;\\n  collectFee: (invoiceId: string, amount: number, paymentMethod: string) => void;\\n  createImprovementPlan: (plan: Omit<ImprovementPlan, \'id\' | \'status\'>) => void;\\n  togglePlanTask: (planId: string, taskId: string) => void;\\n  addStudentRemark: (studentId: string, category: string, comment: string) => void;\\n  publishNotice: (notice: Omit<Notice, \'id\' | \'createdAt\'>) => void;\\n  enrollStudent: (studentData: {\\n    firstName: string;\\n    lastName: string;\\n    email: string;\\n    phone: string;\\n    batchId: string;\\n    gender: \'MALE\' | \'FEMALE\' | \'OTHER\';\\n    bloodGroup: string;\\n    address: string;\\n    parentName?: string;\\n    parentEmail?: string;\\n  }) => void;\\n  transferStudentBatch: (studentId: string, newBatchId: string) => void;\\n  resolveAlert: (alertId: string) => void;\\n}\\n\\nconst IMSContext = createContext<IMSContextType | undefined>(undefined);\\n\\nexport const IMSProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\\n  const [role, setRoleState] = useState<Role>(\'ADMIN\');\\n  const [currentUserId, setCurrentUserId] = useState<string>(\'u-admin\');\\n  const [isDarkMode, setIsDarkMode] = useState<boolean>(false);\\n  const [isMobilePreviewOpen, setMobilePreviewOpen] = useState<boolean>(false);\\n\\n  // Core Data States\\n  const [institute] = useState<Institute>(mockInstitute);\\n  const [users, setUsers] = useState<User[]>(mockUsers);\\n  const [teachers] = useState<TeacherProfile[]>(mockTeachers);\\n  const [students, setStudents] = useState<StudentProfile[]>(mockStudents);\\n  const [parents, setParents] = useState<ParentProfile[]>(mockParents);\\n  const [courses] = useState<Course[]>(mockCourses);\\n  const [subjects] = useState<Subject[]>(mockSubjects);\\n  const [batches, setBatches] = useState<Batch[]>(mockBatches);\\n  const [timetable] = useState<TimetableSlot[]>(mockTimetable);\\n  const [attendanceRecords, setAttendanceRecords] = useState<AttendanceRecord[]>(initialAttendanceRecords);\\n  const [tests, setTests] = useState<Test[]>(mockTests);\\n  const [testResults, setTestResults] = useState<TestResult[]>(mockTestResults);\\n  const [homeworks, setHomeworks] = useState<Homework[]>(mockHomeworks);\\n  const [homeworkSubmissions, setHomeworkSubmissions] = useState<HomeworkSubmission[]>(mockHomeworkSubmissions);\\n  const [feeInvoices, setFeeInvoices] = useState<FeeInvoice[]>(mockFeeInvoices);\\n  const [performanceAlerts, setPerformanceAlerts] = useState<PerformanceAlert[]>(mockPerformanceAlerts);\\n  const [improvementPlans, setImprovementPlans] = useState<ImprovementPlan[]>(mockImprovementPlans);\\n  const [studentRemarks, setStudentRemarks] = useState<StudentRemark[]>(mockStudentRemarks);\\n  const [notices, setNotices] = useState<Notice[]>(mockNotices);\\n  const [badges] = useState<Badge[]>(mockBadges);\\n  const [auditLogs, setAuditLogs] = useState<AuditLog[]>(mockAuditLogs);\\n\\n  // Sync current user when role is switched\\n  const setRole = (newRole: Role) => {\\n    setRoleState(newRole);\\n    if (newRole === \'SUPER_ADMIN\') setCurrentUserId(\'u-superadmin\');\\n    else if (newRole === \'ADMIN\') setCurrentUserId(\'u-admin\');\\n    else if (newRole === \'TEACHER\') setCurrentUserId(\'u-teacher-1\');\\n    else if (newRole === \'STUDENT\') setCurrentUserId(\'u-student-1\');\\n    else if (newRole === \'PARENT\') setCurrentUserId(\'u-parent-1\');\\n  };\\n\\n  const switchUser = (userId: string) => {\\n    const user = users.find(u => u.id === userId);\\n    if (user) {\\n      setCurrentUserId(userId);\\n      setRoleState(user.role);\\n    }\\n  };\\n\\n  const currentUser = useMemo(() => {\\n    return users.find(u => u.id === currentUserId) || users[1]; // default admin\\n  }, [users, currentUserId]);\\n\\n  const toggleDarkMode = () => {\\n    setIsDarkMode(prev => !prev);\\n  };\\n\\n  const getStudentUser = (studentProfileId: string): User | undefined => {\\n    const prof = students.find(s => s.id === studentProfileId);\\n    if (!prof) return undefined;\\n    return users.find(u => u.id === prof.userId);\\n  };\\n\\n  const getTeacherUser = (teacherProfileId: string): User | undefined => {\\n    const prof = teachers.find(t => t.id === teacherProfileId);\\n    if (!prof) return undefined;\\n    return users.find(u => u.id === prof.userId);\\n  };\\n\\n  const getBatchStudents = (batchId: string): Array<{ student: StudentProfile; user: User }> => {\\n    return students\\n      .filter(s => s.batchId === batchId)\\n      .map(student => ({\\n        student,\\n        user: users.find(u => u.id === student.userId)!\\n      }))\\n      .filter(item => Boolean(item.user));\\n  };\\n\\n  const getStudentDiagnostic = (studentId: string): StudentDiagnosticResult => {\\n    const student = students.find(s => s.id === studentId);\\n    if (!student) {\\n      return {\\n        studentId,\\n        overallAverage: 0,\\n        classAverageDelta: 0,\\n        attendanceRate: 100,\\n        subjectWeaknesses: [],\\n        subjectStrengths: [],\\n        flags: [],\\n        automatedRecommendations: []\\n      };\\n    }\\n\\n    const studentAtt = attendanceRecords.filter(a => a.studentId === studentId);\\n\\n    // Build tests input\\n    const studentTestInputs = testResults\\n      .filter(tr => tr.studentId === studentId)\\n      .map(tr => {\\n        const test = tests.find(t => t.id === tr.testId);\\n        if (!test) return null;\\n\\n        // compute class average for this test\\n        const allTestResults = testResults.filter(r => r.testId === test.id);\\n        const avgMarks =\\n          allTestResults.length > 0\\n            ? allTestResults.reduce((acc, curr) => acc + curr.marksObtained, 0) / allTestResults.length\\n            : test.passingMarks;\\n        const classAveragePct = (avgMarks / test.maxMarks) * 100;\\n\\n        return {\\n          subjectName: test.subjectName,\\n          marksObtained: tr.marksObtained,\\n          maxMarks: test.maxMarks,\\n          testDate: test.testDate,\\n          classAveragePct\\n        };\\n      })\\n      .filter(Boolean) as Array<{\\n        subjectName: string;\\n        marksObtained: number;\\n        maxMarks: number;\\n        testDate: string;\\n        classAveragePct: number;\\n      }>;\\n\\n    // Count pending homeworks\\n    const submittedHwIds = new Set(\\n      homeworkSubmissions.filter(s => s.studentId === studentId).map(s => s.homeworkId)\\n    );\\n    const batchHws = homeworks.filter(h => h.batchId === student.batchId);\\n    const pendingHomeworkCount = batchHws.filter(h => !submittedHwIds.has(h.id)).length;\\n\\n    return computeStudentDiagnostics(studentId, studentTestInputs, studentAtt, pendingHomeworkCount);\\n  };\\n\\n  // Actions\\n  const markBatchAttendance = (\\n    batchId: string,\\n    date: string,\\n    records: Record<string, \'PRESENT\' | \'ABSENT\' | \'LATE\' | \'EXCUSED\'>,\\n    remarks?: Record<string, string>\\n  ) => {\\n    const sessionId = `sess-${date}-${batchId}`;\\n    const newRecords: AttendanceRecord[] = [];\\n\\n    // Filter out existing records for this batch and date to replace\\n    const otherRecords = attendanceRecords.filter(\\n      r => !(r.date === date && Object.keys(records).includes(r.studentId))\\n    );\\n\\n    Object.entries(records).forEach(([studentId, status]) => {\\n      newRecords.push({\\n        id: `att-${date}-${studentId}-${Date.now()}`,\\n        sessionId,\\n        studentId,\\n        status,\\n        date,\\n        remarks: remarks?.[studentId]\\n      });\\n    });\\n\\n    setAttendanceRecords([...otherRecords, ...newRecords]);\\n\\n    // Recalculate streaks for students\\n    setStudents(prevStudents =>\\n      prevStudents.map(student => {\\n        if (records[student.id]) {\\n          const st = records[student.id];\\n          if (st === \'PRESENT\' || st === \'LATE\') {\\n            const nextStreak = student.currentStreak + 1;\\n            return {\\n              ...student,\\n              currentStreak: nextStreak,\\n              highestStreak: Math.max(student.highestStreak, nextStreak)\\n            };\\n          } else if (st === \'ABSENT\') {\\n            return {\\n              ...student,\\n              currentStreak: 0\\n            };\\n          }\\n        }\\n        return student;\\n      })\\n    );\\n\\n    // Add Audit Log\\n    const log: AuditLog = {\\n      id: `log-${Date.now()}`,\\n      timestamp: new Date().toISOString().replace(\'T\', \' \').substring(0, 19),\\n      userId: currentUser.id,\\n      userName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      action: \'ATTENDANCE_MARKED\',\\n      entity: `Batch: ${batchId}`,\\n      details: `Recorded roll call for ${Object.keys(records).length} students on ${date}`,\\n      ipAddress: \'192.168.1.100\'\\n    };\\n    setAuditLogs(prev => [log, ...prev]);\\n  };\\n\\n  const createTest = (\\n    test: Omit<Test, \'id\'>,\\n    initialMarks?: Record<string, number>\\n  ) => {\\n    const newTestId = `test-${Date.now()}`;\\n    const newTest: Test = {\\n      ...test,\\n      id: newTestId\\n    };\\n    setTests(prev => [newTest, ...prev]);\\n\\n    if (initialMarks) {\\n      const newResults: TestResult[] = Object.entries(initialMarks).map(([studentId, marks]) => ({\\n        id: `tr-${newTestId}-${studentId}`,\\n        testId: newTestId,\\n        studentId,\\n        marksObtained: marks,\\n        percentile: Math.min(99, Math.round((marks / test.maxMarks) * 100))\\n      }));\\n      setTestResults(prev => [...prev, ...newResults]);\\n    }\\n\\n    const log: AuditLog = {\\n      id: `log-${Date.now()}`,\\n      timestamp: new Date().toISOString().replace(\'T\', \' \').substring(0, 19),\\n      userId: currentUser.id,\\n      userName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      action: \'TEST_CREATED\',\\n      entity: `Test: ${newTest.title}`,\\n      details: `Scheduled test for ${test.subjectName} with max marks ${test.maxMarks}`,\\n      ipAddress: \'192.168.1.100\'\\n    };\\n    setAuditLogs(prev => [log, ...prev]);\\n  };\\n\\n  const saveTestMarks = (\\n    testId: string,\\n    results: Array<{ studentId: string; marksObtained: number; remarks?: string }>\\n  ) => {\\n    const test = tests.find(t => t.id === testId);\\n    const maxMarks = test?.maxMarks || 100;\\n\\n    // Calculate percentiles\\n    const sorted = [...results].sort((a, b) => a.marksObtained - b.marksObtained);\\n    const total = sorted.length;\\n\\n    const newResults: TestResult[] = results.map(r => {\\n      const rank = sorted.findIndex(item => item.studentId === r.studentId) + 1;\\n      const percentile = total > 1 ? Math.round((rank / total) * 100) : 100;\\n      return {\\n        id: `tr-${testId}-${r.studentId}`,\\n        testId,\\n        studentId: r.studentId,\\n        marksObtained: r.marksObtained,\\n        percentile,\\n        remarks: r.remarks\\n      };\\n    });\\n\\n    const otherResults = testResults.filter(tr => tr.testId !== testId);\\n    setTestResults([...otherResults, ...newResults]);\\n\\n    // Check if any student scored poorly and trigger alert\\n    results.forEach(r => {\\n      if (r.marksObtained / maxMarks < 0.4) {\\n        const student = students.find(s => s.id === r.studentId);\\n        const user = student ? users.find(u => u.id === student.userId) : null;\\n        if (student && user) {\\n          const alert: PerformanceAlert = {\\n            id: `alert-${Date.now()}-${student.id}`,\\n            studentId: student.id,\\n            studentName: `${user.firstName} ${user.lastName}`,\\n            batchName: batches.find(b => b.id === student.batchId)?.name || \'Active Batch\',\\n            category: \'ACADEMIC_DROP\',\\n            title: `Low Score in ${test?.subjectName || \'Exam\'}`,\\n            message: `Scored ${r.marksObtained}/${maxMarks} (${Math.round((r.marksObtained / maxMarks) * 100)}%). Below required pass grade.`,\\n            severity: \'HIGH\',\\n            isResolved: false,\\n            createdAt: new Date().toISOString().split(\'T\')[0]\\n          };\\n          setPerformanceAlerts(prev => [alert, ...prev]);\\n        }\\n      }\\n    });\\n\\n    const log: AuditLog = {\\n      id: `log-${Date.now()}`,\\n      timestamp: new Date().toISOString().replace(\'T\', \' \').substring(0, 19),\\n      userId: currentUser.id,\\n      userName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      action: \'MARKS_COMMITTED\',\\n      entity: `Test: ${testId}`,\\n      details: `Saved evaluation marks for ${results.length} students`,\\n      ipAddress: \'192.168.1.100\'\\n    };\\n    setAuditLogs(prev => [log, ...prev]);\\n  };\\n\\n  const createHomework = (hw: Omit<Homework, \'id\' | \'totalSubmissions\'>) => {\\n    const newHw: Homework = {\\n      ...hw,\\n      id: `hw-${Date.now()}`,\\n      totalSubmissions: 0\\n    };\\n    setHomeworks(prev => [newHw, ...prev]);\\n\\n    const log: AuditLog = {\\n      id: `log-${Date.now()}`,\\n      timestamp: new Date().toISOString().replace(\'T\', \' \').substring(0, 19),\\n      userId: currentUser.id,\\n      userName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      action: \'HOMEWORK_PUBLISHED\',\\n      entity: `Homework: ${newHw.title}`,\\n      details: `Assigned to batch ${hw.batchId}, due on ${hw.dueDate}`,\\n      ipAddress: \'192.168.1.100\'\\n    };\\n    setAuditLogs(prev => [log, ...prev]);\\n  };\\n\\n  const submitHomework = (homeworkId: string, studentId: string, fileName: string) => {\\n    const submissionId = `sub-${Date.now()}`;\\n    const newSubmission: HomeworkSubmission = {\\n      id: submissionId,\\n      homeworkId,\\n      studentId,\\n      submissionDate: new Date().toISOString().split(\'T\')[0],\\n      fileName,\\n      status: \'SUBMITTED\'\\n    };\\n\\n    const otherSubs = homeworkSubmissions.filter(\\n      s => !(s.homeworkId === homeworkId && s.studentId === studentId)\\n    );\\n    setHomeworkSubmissions([...otherSubs, newSubmission]);\\n\\n    // Update homework count\\n    setHomeworks(prev =>\\n      prev.map(h => (h.id === homeworkId ? { ...h, totalSubmissions: h.totalSubmissions + 1 } : h))\\n    );\\n  };\\n\\n  const gradeHomework = (submissionId: string, grade: string, score: number, feedback: string) => {\\n    setHomeworkSubmissions(prev =>\\n      prev.map(s =>\\n        s.id === submissionId\\n          ? {\\n              ...s,\\n              status: \'EVALUATED\',\\n              grade,\\n              score,\\n              feedback\\n            }\\n          : s\\n      )\\n    );\\n  };\\n\\n  const collectFee = (invoiceId: string, amount: number, paymentMethod: string) => {\\n    setFeeInvoices(prev =>\\n      prev.map(inv => {\\n        if (inv.id === invoiceId) {\\n          const totalPaid = inv.paidAmount + amount;\\n          const status = totalPaid >= inv.amount ? \'PAID\' : \'PARTIAL\';\\n          return {\\n            ...inv,\\n            paidAmount: totalPaid,\\n            status,\\n            paymentMethod,\\n            paidDate: new Date().toISOString().split(\'T\')[0],\\n            receiptNumber: `REC-${Date.now().toString().slice(-6)}`\\n          };\\n        }\\n        return inv;\\n      })\\n    );\\n\\n    const log: AuditLog = {\\n      id: `log-${Date.now()}`,\\n      timestamp: new Date().toISOString().replace(\'T\', \' \').substring(0, 19),\\n      userId: currentUser.id,\\n      userName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      action: \'FEE_PAYMENT_COLLECTED\',\\n      entity: `Invoice: ${invoiceId}`,\\n      details: `Collected $${amount.toFixed(2)} via ${paymentMethod}`,\\n      ipAddress: \'192.168.1.100\'\\n    };\\n    setAuditLogs(prev => [log, ...prev]);\\n  };\\n\\n  const createImprovementPlan = (plan: Omit<ImprovementPlan, \'id\' | \'status\'>) => {\\n    const newPlan: ImprovementPlan = {\\n      ...plan,\\n      id: `plan-${Date.now()}`,\\n      status: \'IN_PROGRESS\'\\n    };\\n    setImprovementPlans(prev => [newPlan, ...prev]);\\n  };\\n\\n  const togglePlanTask = (planId: string, taskId: string) => {\\n    setImprovementPlans(prev =>\\n      prev.map(plan => {\\n        if (plan.id === planId) {\\n          const updatedTasks = plan.tasks.map(t => (t.id === taskId ? { ...t, isDone: !t.isDone } : t));\\n          const allDone = updatedTasks.every(t => t.isDone);\\n          return {\\n            ...plan,\\n            tasks: updatedTasks,\\n            status: allDone ? \'COMPLETED\' : \'IN_PROGRESS\'\\n          };\\n        }\\n        return plan;\\n      })\\n    );\\n  };\\n\\n  const addStudentRemark = (studentId: string, category: string, comment: string) => {\\n    const newRemark: StudentRemark = {\\n      id: `rem-${Date.now()}`,\\n      studentId,\\n      authorName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      authorRole: currentUser.title || currentUser.role,\\n      category,\\n      comment,\\n      createdAt: new Date().toISOString().split(\'T\')[0]\\n    };\\n    setStudentRemarks(prev => [newRemark, ...prev]);\\n  };\\n\\n  const publishNotice = (notice: Omit<Notice, \'id\' | \'createdAt\'>) => {\\n    const newNotice: Notice = {\\n      ...notice,\\n      id: `not-${Date.now()}`,\\n      createdAt: new Date().toISOString().split(\'T\')[0]\\n    };\\n    setNotices(prev => [newNotice, ...prev]);\\n\\n    const log: AuditLog = {\\n      id: `log-${Date.now()}`,\\n      timestamp: new Date().toISOString().replace(\'T\', \' \').substring(0, 19),\\n      userId: currentUser.id,\\n      userName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      action: \'CIRCULAR_PUBLISHED\',\\n      entity: `Notice: ${newNotice.title}`,\\n      details: `Published circular targeted to ${notice.targetRole || \'ALL\'}`,\\n      ipAddress: \'192.168.1.100\'\\n    };\\n    setAuditLogs(prev => [log, ...prev]);\\n  };\\n\\n  const enrollStudent = (studentData: {\\n    firstName: string;\\n    lastName: string;\\n    email: string;\\n    phone: string;\\n    batchId: string;\\n    gender: \'MALE\' | \'FEMALE\' | \'OTHER\';\\n    bloodGroup: string;\\n    address: string;\\n    parentName?: string;\\n    parentEmail?: string;\\n  }) => {\\n    const newUserId = `u-student-${Date.now()}`;\\n    const newStudentId = `sp-${Date.now()}`;\\n    const rollNum = `ST-${Math.floor(1000 + Math.random() * 9000)}`;\\n\\n    const newUser: User = {\\n      id: newUserId,\\n      instituteId: \'inst-01\',\\n      email: studentData.email,\\n      role: \'STUDENT\',\\n      firstName: studentData.firstName,\\n      lastName: studentData.lastName,\\n      phone: studentData.phone,\\n      isActive: true,\\n      title: \'Enrolled Scholar\'\\n    };\\n\\n    const newProfile: StudentProfile = {\\n      id: newStudentId,\\n      userId: newUserId,\\n      batchId: studentData.batchId,\\n      rollNumber: rollNum,\\n      admissionNumber: `ADM-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`,\\n      admissionDate: new Date().toISOString().split(\'T\')[0],\\n      gender: studentData.gender,\\n      bloodGroup: studentData.bloodGroup,\\n      address: studentData.address,\\n      currentStreak: 0,\\n      highestStreak: 0,\\n      badgePoints: 50,\\n      gradeLevel: \'Grade 11\'\\n    };\\n\\n    // If parent details provided, optionally create parent\\n    if (studentData.parentEmail && studentData.parentName) {\\n      const parentUserId = `u-parent-${Date.now()}`;\\n      const parentProfId = `pp-${Date.now()}`;\\n      const [pfName, ...plNames] = studentData.parentName.split(\' \');\\n      const parentUser: User = {\\n        id: parentUserId,\\n        instituteId: \'inst-01\',\\n        email: studentData.parentEmail,\\n        role: \'PARENT\',\\n        firstName: pfName || \'Guardian\',\\n        lastName: plNames.join(\' \') || \'Guardian\',\\n        isActive: true,\\n        title: \'Guardian\'\\n      };\\n      const parentProf: ParentProfile = {\\n        id: parentProfId,\\n        userId: parentUserId,\\n        occupation: \'Guardian\',\\n        childrenIds: [newStudentId]\\n      };\\n      newProfile.parentId = parentProfId;\\n      setUsers(prev => [...prev, newUser, parentUser]);\\n      setParents(prev => [...prev, parentProf]);\\n    } else {\\n      setUsers(prev => [...prev, newUser]);\\n    }\\n\\n    setStudents(prev => [...prev, newProfile]);\\n\\n    // Update batch count\\n    setBatches(prev =>\\n      prev.map(b => (b.id === studentData.batchId ? { ...b, enrolledCount: b.enrolledCount + 1 } : b))\\n    );\\n\\n    // Create initial invoice\\n    const initialInvoice: FeeInvoice = {\\n      id: `inv-${Date.now()}`,\\n      studentId: newStudentId,\\n      title: \'Term 2 Academic Enrollment & Facilities Levy\',\\n      amount: 1450,\\n      paidAmount: 0,\\n      dueDate: new Date(Date.now() + 14 * 86400000).toISOString().split(\'T\')[0],\\n      status: \'DUE\'\\n    };\\n    setFeeInvoices(prev => [initialInvoice, ...prev]);\\n\\n    const log: AuditLog = {\\n      id: `log-${Date.now()}`,\\n      timestamp: new Date().toISOString().replace(\'T\', \' \').substring(0, 19),\\n      userId: currentUser.id,\\n      userName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      action: \'STUDENT_ENROLLED\',\\n      entity: `Student: ${newStudentId}`,\\n      details: `Enrolled ${studentData.firstName} ${studentData.lastName} into batch ${studentData.batchId}`,\\n      ipAddress: \'192.168.1.100\'\\n    };\\n    setAuditLogs(prev => [log, ...prev]);\\n  };\\n\\n  const transferStudentBatch = (studentId: string, newBatchId: string) => {\\n    const student = students.find(s => s.id === studentId);\\n    if (!student) return;\\n    const oldBatchId = student.batchId;\\n\\n    setStudents(prev =>\\n      prev.map(s => (s.id === studentId ? { ...s, batchId: newBatchId } : s))\\n    );\\n\\n    setBatches(prev =>\\n      prev.map(b => {\\n        if (b.id === oldBatchId) return { ...b, enrolledCount: Math.max(0, b.enrolledCount - 1) };\\n        if (b.id === newBatchId) return { ...b, enrolledCount: b.enrolledCount + 1 };\\n        return b;\\n      })\\n    );\\n\\n    const log: AuditLog = {\\n      id: `log-${Date.now()}`,\\n      timestamp: new Date().toISOString().replace(\'T\', \' \').substring(0, 19),\\n      userId: currentUser.id,\\n      userName: `${currentUser.firstName} ${currentUser.lastName}`,\\n      action: \'BATCH_TRANSFER\',\\n      entity: `StudentProfile: ${studentId}`,\\n      details: `Transferred student from ${oldBatchId} to ${newBatchId}`,\\n      ipAddress: \'192.168.1.100\'\\n    };\\n    setAuditLogs(prev => [log, ...prev]);\\n  };\\n\\n  const resolveAlert = (alertId: string) => {\\n    setPerformanceAlerts(prev =>\\n      prev.map(a => (a.id === alertId ? { ...a, isResolved: true } : a))\\n    );\\n  };\\n\\n  return (\\n    <IMSContext.Provider\\n      value={{\\n        role,\\n        setRole,\\n        currentUser,\\n        switchUser,\\n        isDarkMode,\\n        toggleDarkMode,\\n        isMobilePreviewOpen,\\n        setMobilePreviewOpen,\\n\\n        institute,\\n        users,\\n        teachers,\\n        students,\\n        parents,\\n        courses,\\n        subjects,\\n        batches,\\n        timetable,\\n        attendanceRecords,\\n        tests,\\n        testResults,\\n        homeworks,\\n        homeworkSubmissions,\\n        feeInvoices,\\n        performanceAlerts,\\n        improvementPlans,\\n        studentRemarks,\\n        notices,\\n        badges,\\n        auditLogs,\\n\\n        getStudentUser,\\n        getTeacherUser,\\n        getBatchStudents,\\n        getStudentDiagnostic,\\n\\n        markBatchAttendance,\\n        createTest,\\n        saveTestMarks,\\n        createHomework,\\n        submitHomework,\\n        gradeHomework,\\n        collectFee,\\n        createImprovementPlan,\\n        togglePlanTask,\\n        addStudentRemark,\\n        publishNotice,\\n        enrollStudent,\\n        transferStudentBatch,\\n        resolveAlert\\n      }}\\n    >\\n      <div className={isDarkMode ? \'dark\' : \'\'}>\\n        {children}\\n      </div>\\n    </IMSContext.Provider>\\n  );\\n};\\n\\nexport const useIMS = () => {\\n  const context = useContext(IMSContext);\\n  if (!context) throw new Error(\'useIMS must be used within IMSProvider\');\\n  return context;\\n};\\n\", \"Description\":\"Create centralized React Context for IMS with role management and actions\", \"Overwrite\":true, \"TargetFile\":\"/src/context/IMSContext.tsx\", \"toolAction\":\"Creating IMSContext\", \"toolSummary\":\"Create IMSContext for global state and actions\"}"
