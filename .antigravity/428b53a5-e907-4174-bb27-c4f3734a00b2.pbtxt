    content: "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"><title>TuitionPro: Coaching Class Manager</title>\n<style>\n:root{--bg:#f2f5f4;--cd:#fff;--tx:#17211f;--mu:#64726f;--ac:#0f766e;--bd:#dce4e2;--ok:#15803d;--bad:#b91c1c;--wn:#b45309;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}\n@media(prefers-color-scheme:dark){:root:not([data-theme=\"light\"]){--bg:#101615;--cd:#18211f;--tx:#e6efed;--mu:#93a5a1;--ac:#2dd4bf;--bd:#2a3836;--ok:#4ade80;--bad:#f87171;--wn:#fbbf24}}\n:root[data-theme=\"dark\"]{--bg:#101615;--cd:#18211f;--tx:#e6efed;--mu:#93a5a1;--ac:#2dd4bf;--bd:#2a3836;--ok:#4ade80;--bad:#f87171;--wn:#fbbf24}\nhtml{scroll-padding-top:env(safe-area-inset-top,0px)}\nbody{margin:0;background:var(--bg);color:var(--tx);font:14px/1.45 \"Avenir Next\",\"Segoe UI\",system-ui,sans-serif}\nheader{display:flex;gap:8px;align-items:center;padding:10px 12px;background:var(--cd);border-bottom:1px solid var(--bd)}\nheader b{font-size:17px}.mu{color:var(--mu);font-size:12px}\n.app{display:flex;flex-direction:column}\nnav{display:flex;gap:4px;overflow-x:auto;padding:8px;background:var(--cd);border-bottom:1px solid var(--bd)}\nnav button{white-space:nowrap;border-color:transparent;text-align:left}\nmain{flex:1;min-width:0;padding:12px}\n@media(min-width:860px){.app{flex-direction:row}nav{flex-direction:column;width:190px;overflow:visible;border-right:1px solid var(--bd);border-bottom:0;min-height:90vh}}\n.c{background:var(--cd);border:1px solid var(--bd);border-radius:8px;padding:12px;margin-bottom:12px}\n.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:12px}.g .c{margin:0}.g h2{margin:2px 0 0;font-size:24px}\n.w{overflow-x:auto}table{border-collapse:collapse;width:100%}th,td{padding:6px 8px;border-bottom:1px solid var(--bd);text-align:left;white-space:nowrap}th{color:var(--mu);font-weight:600}\ninput,select,button,textarea{font:inherit;padding:6px 8px;border:1px solid var(--bd);border-radius:6px;background:var(--cd);color:var(--tx)}\nbutton{cursor:pointer}button.p{background:var(--ac);color:var(--bg);border-color:var(--ac)}\n:focus-visible{outline:2px solid var(--ac);outline-offset:1px}\n.fm{display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin:8px 0}.fm label{display:flex;flex-direction:column;font-size:12px;color:var(--mu)}\n.ok{color:var(--ok)}.bad{color:var(--bad)}.wn{color:var(--wn)}h3{margin:0 0 6px}\n#ts{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:var(--tx);color:var(--bg);padding:8px 14px;border-radius:8px;display:none;z-index:9}\n#md{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;overflow:auto;z-index:8}\n</style></head><body>\n<header><b>TuitionPro</b><input placeholder=\"Institute you are visiting\" style=\"width:150px\" onchange=\"vs=this.value;R()\"><span style=\"flex:1\"></span><select id=\"rl\" onchange=\"role=this.value;R()\"><option>Admin</option><option>Teacher</option><option>Parent</option></select><button onclick=\"th()\">Theme</button></header>\n<div class=\"app\"><nav id=\"nv\"></nav><main id=\"mn\"></main></div><div id=\"ts\"></div><div id=\"md\"></div>\n<script>\nconst $=s=>document.querySelector(s),today=new Date().toISOString().slice(0,10),inr=n=>Number(n).toLocaleString(\'en-IN\');\nconst T=(h,r)=>`<div class=\"w\"><table><tr>${h.map(x=>`<th>${x}</th>`).join(\'\')}</tr>${r.length?r.map(x=>`<tr>${x.map(c=>`<td>${c}</td>`).join(\'\')}</tr>`).join(\'\'):`<tr><td colspan=\"${h.length}\">No records yet</td></tr>`}</table></div>`;\nlet fi=0,FN={},pg=\'dash\',role=\'Admin\',q=\'\',pv=null,ab=\'10-A\',ad=today,xe=0,ps=\'Aarav\',pc=\'Aarav\',rp=\'All\',fr=\'\',to=\'\',vs=\'\',FB={};try{FB=JSON.parse(localStorage.getItem(\'tp_fb\')||\'{}\')}catch(e){}\nconst F=(fs,b,fn)=>{co