              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        if (!scores.length) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        const avg = Math.round((scores.reduce((a, b) => a + b, 0) / scores.length / test.maxMarks) * 100);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        return ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
