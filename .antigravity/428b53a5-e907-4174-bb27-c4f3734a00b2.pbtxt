  code_action {
    action_spec {
      create_file {
        instruction: "export type Role = \'SUPER_ADMIN\' | \'ADMIN\' | \'TEACHER\' | \'STUDENT\' | \'PARENT\';\n\nexport type Gender = \'MALE\' | \'FEMALE\' | \'OTHER\';\n\nexport type AttendanceStatus = \'PRESENT\' | \'ABSENT\' | \'LATE\' | \'EXCUSED\';\n\nexport type PaymentStatus = \'PAID\' | \'PARTIAL\' | \'DUE\' | \'OVERDUE\';\n\nexport type SubmissionStatus = \'PENDING\' | \'SUBMITTED\' | \'LATE\' | \'EVALUATED\';\n\nexport type SeverityLevel = \'LOW\' | \'MEDIUM\' | \'HIGH\' | \'CRITICAL\';\n\nexport interface Institute {\n  id: string;\n  name: string;\n  code: string;\n  address?: string;\n  phone?: string;\n  email: string;\n  logoUrl?: string;\n  campusCount: number;\n  totalStudents: number;\n  totalFaculty: number;\n}\n\nexport interface User {\n  id: string;\n  instituteId: string;\n  email: string;\n  role: Role;\n  firstName: string;\n  lastName: string;\n  phone?: string;\n  avatarUrl?: string;\n  isActive: boolean;\n  title?: string;\n}\n\nexport interface TeacherProfile {\n  id: string;\n  userId: string;\n  employeeCode: string;\n  qualification: string;\n  specialization: string;\n  joiningDate: string;\n  workloadHoursPerWeek: number;\n}\n\nexport interface ParentProfile {\n  id: string;\n  userId: string;\n  occupation: string;\n  childrenIds: string[]; // studentProfile ids\n}\n\nexport interface StudentProfile {\n  id: string;\n  userId: string;\n  parentId?: string;\n  batchId: string;\n  rollNumber: string;\n  admissionNumber: string;\n  admissionDate: string;\n  dateOfBirth?: string;\n  gender: Gender;\n  bloodGroup?: string;\n  address?: string;\n  currentStreak: number;\n  highestStreak: number;\n  badgePoints: number;\n  gradeLevel: string;\n}\n\nexport interface Course {\n  id: string;\n  instituteId: string;\n  name: string;\n  code: string;\n  description?: string;\n}\n\nexport interface Subject {\n  id: string;\n  courseId: string;\n  name: string;\n  code: string;\n}\n\nexport interface Batch {\n  id: string;\n  instituteId: string;\n  courseId: string;\n  name: string;\n  startDate: string;\n  endDate?: string;\n  maxCapacity: number;\n  enrolledCount: number;\n  roomNumber?: string;\n}\n\nexport interface TimetableSlot {\n  id: string;\n  batchId: string;\n  dayOfWeek: number; // 1 = Monday, 5 = Friday\n  startTime: string;\n  endTime: string;\n  subjectName: string;\n  teacherName: string;\n  classroom: string;\n}\n\nexport interface AttendanceRecord {\n  id: string;\n  sessionId: string;\n  studentId: string;\n  status: AttendanceStatus;\n  remarks?: string;\n  date: string;\n}\n\nexport interface AttendanceSession {\n  id: string;\n  batchId: string;\n  date: string;\n  takenById: string;\n  records: AttendanceRecord[];\n}\n\nexport interface Test {\n  id: string;\n  batchId: string;\n  subjectId: string;\n  subjectName: string;\n  teacherId: string;\n  title: string;\n  maxMarks: number;\n  passingMarks: number;\n  testDate: string;\n}\n\nexport interface TestResult {\n  id: string;\n  testId: string;\n  studentId: string;\n  marksObtained: number;\n  percentile?: number;\n  remarks?: string;\n}\n\nexport interface Homework {\n  id: string;\n  batchId: string;\n  subjectId: string;\n  subjectName: string;\n  title: string;\n  description: string;\n  dueDate: string;\n  totalSubmissions: number;\n}\n\nexport interface HomeworkSubmission {\n  id: string;\n  homeworkId: string;\n  studentId: string;\n  submissionDate: string;\n  fileUrl?: string;\n  fileName?: string;\n  status: SubmissionStatus;\n  grade?: string;\n  score?: number;\n  feedback?: string;\n}\n\nexport interface FeeInvoice {\n  id: string;\n  studentId: string;\n  title: string;\n  amount: number;\n  paidAmount: number;\n  dueDate: string;\n  status: PaymentStatus;\n  receiptNumber?: string;\n  paymentMethod?: string;\n  paidDate?: string;\n}\n\nexport interface PerformanceAlert {\n  id: string;\n  studentId: string;\n  studentName: string;\n  batchName: string;\n  category: \'ATTENDANCE\' | \'ACADEMIC_DROP\' | \'HOMEWORK\' | \'CHRONIC_WEAKNESS\';\n  title: string;\n  message: string;\n  severity: SeverityLevel;\n  isResolved: boolean;\n  createdAt: string;\n}\n\nexport interface ImprovementPlanTask {\n  id: string;\n  planId: string;\n  assignedById: string;\n  title: string;\n  isDone: boolean;\n}\n\nexport interface ImprovementPlan {\n  id: string;\n  studentId: string;\n  studentName: string;\n  subjectName: string;\n  focusArea: string;\n  targetScore: number;\n  deadline: string;\n  status: \'IN_PROGRESS\' | \'COMPLETED\' | \'OVERDUE\';\n  tasks: ImprovementPlanTask[];\n}\n\nexport interface StudentRemark {\n  id: string;\n  studentId: string;\n  authorName: string;\n  authorRole: string;\n  category: string;\n  comment: string;\n  createdAt: string;\n}\n\nexport interface Notice {\n  id: string;\n  instituteId: string;\n  authorId: string;\n  authorName: string;\n  title: string;\n  content: string;\n  targetRole?: Role | \'ALL\';\n  priority: \'NORMAL\' | \'HIGH\' | \'EMERGENCY\';\n  createdAt: string;\n}\n\nexport interface Badge {\n  id: string;\n  name: string;\n  earnedAt: string;\n  icon: string;\n  description: string;\n  category: \'ATTENDANCE\' | \'ACADEMIC\' | \'HOMEWORK\' | \'LEADERSHIP\';\n  points: number;\n}\n\nexport interface AuditLog {\n  id: string;\n  timestamp: string;\n  userId: string;\n  userName: string;\n  action: string;\n  entity: string;\n  details: string;\n  ipAddress: string;\n}\n"
        path {
          absolute_uri: "file:///src/types/ims.ts"
        }
        overwrite: true
      }
    }
