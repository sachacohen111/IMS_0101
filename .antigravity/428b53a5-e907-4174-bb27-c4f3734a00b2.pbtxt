erName: \'Marcus Chen\', classroom: \'CS Lab 2B\' },\\n  { id: \'tt-5\', batchId: \'batch-alpha\', dayOfWeek: 2, startTime: \'10:15\', endTime: \'11:45\', subjectName: \'Physics Problem Clinic\', teacherName: \'Prof. Vikram Nair\', classroom: \'LH 401\' },\\n  { id: \'tt-6\', batchId: \'batch-alpha\', dayOfWeek: 3, startTime: \'09:00\', endTime: \'10:30\', subjectName: \'Calculus Advanced Proofs\', teacherName: \'Prof. Vikram Nair\', classroom: \'LH 401\' },\\n  { id: \'tt-7\', batchId: \'batch-alpha\', dayOfWeek: 3, startTime: \'11:00\', endTime: \'12:30\', subjectName: \'Chemistry Practical\', teacherName: \'Dr. Elena Rostova\', classroom: \'Chem Lab A\' },\\n  { id: \'tt-8\', batchId: \'batch-alpha\', dayOfWeek: 4, startTime: \'08:30\', endTime: \'10:00\', subjectName: \'Kinematics & Dynamics\', teacherName: \'Prof. Vikram Nair\', classroom: \'LH 401\' },\\n  { id: \'tt-9\', batchId: \'batch-alpha\', dayOfWeek: 5, startTime: \'10:00\', endTime: \'11:30\', subjectName: \'Weekly Quiz & Diagnostics\', teacherName: \'Prof. Vikram Nair\', classroom: \'LH 401\' }\\n];\\n\\n// Generate past 28 days of attendance records for students in Batch Alpha\\nexport function generatePastAttendanceRecords(): AttendanceRecord[] {\\n  const records: AttendanceRecord[] = [];\\n  const studentIds = [\'sp-01\', \'sp-02\', \'sp-03\', \'sp-04\', \'sp-06\', \'sp-07\'];\\n  const today = new Date();\\n\\n  for (let i = 27; i >= 0; i--) {\\n    const d = new Date(today);\\n    d.setDate(d.getDate() - i);\\n    const dayOfWeek = d.getDay();\\n    if (dayOfWeek === 0 || dayOfWeek === 6) continue; // Skip weekend\\n\\n    const dateStr = d.toISOString().split(\'T\')[0];\\n\\n    studentIds.forEach(sid => {\\n      let status: \'PRESENT\' | \'ABSENT\' | \'LATE\' | \'EXCUSED\' = \'PRESENT\';\\n      if (sid === \'sp-03\') {\\n        // Rohan Mehta: high absenteeism ~65% attendance\\n        const rand = (i + 3) % 5;\\n        if (rand === 0) status = \'ABSENT\';\\n        else if (rand === 1) status = \'LATE\';\\n        else status = \'PRESENT\';\\n      } else if (sid === \'sp-01\') {\\n        // Aarav Patel: very high attendance\\n        if (i === 18) status = \'LATE\';\\n        else status = \'PRESENT\';\\n      } else {\\n        const rand = (i * 7 + sid.charCodeAt(3)) % 13;\\n        if (rand === 0) status = \'ABSENT\';\\n        else if (rand === 1) status = \'LATE\';\\n        else status = \'PRESENT\';\\n      }\\n\\n      records.push({\\n        id: `att-${dateStr}-${sid}`,\\n        sessionId: `sess-${dateStr}`,\\n        studentId: sid,\\n        status,\\n        date: dateStr,\\n        remarks: status === \'LATE\' ? \'Bus transit delay\' : status === \'ABSENT\' ? \'Unexcused\' : undefined\\n      });\\n    });\\n  }\\n  return records;\\n}\\n\\nexport const initialAttendanceRecords: AttendanceRecord[] = generatePastAttendanceRecords();\\n\\nexport const mockTests: Test[] = [\\n  {\\n    id: \'test-01\',\\n    batchId: \'batch-alpha\',\\n    subjectId: \'sub-phy\',\\n    subjectName: \'Physics: Mechanics & Waves\',\\n    teacherId: \'tp-01\',\\n    title: \'Kinematics & Newton\342\200\231s Laws Benchmark\',\\n    maxMarks: 100,\\n    passingMarks: 40,\\n    testDate: \'2024-09-15\'\\n  },\\n  {\\n    id: \'test-02\',\\n    batchId: \'batch-alpha\',\\n    subjectId: \'sub-math\',\\n    subjectName: \'Mathematics: Differential Calculus\',\\n    teacherId: \'tp-01\',\\n    title: \'Limits, Continuity & Derivative Theorems\',\\n    maxMarks: 100,\\n    passingMarks: 40,\\n    testDate: \'2024-09-28\'\\n  },\\n  {\\n    id: \'test-03\',\\n    batchId: \'batch-alpha\',\\n    subjectId: \'sub-chem\',\\n    subjectName: \'Chemistry: Kinetics & Equilibrium\',\\n    teacherId: \'tp-02\',\\n    title: \'Thermodynamics & Equilibrium Constants\',\\n    maxMarks: 80,\\n    passingMarks: 32,\\n    testDate: \'2024-10-10\'\\n  },\\n  {\\n    id: \'test-04\',\\n    batchId: \'batch-alpha\',\\n    subjectId: \'sub-phy\',\\n    subjectName: \'Physics: Mechanics & Waves\',\\n    teacherId: \'tp-01\',\\n    title: \'Work, Energy & Momentum Deep-Dive\',\\n    maxMarks: 100,\\n    passingMarks: 40,\\n    testDate: \'2024-10-20\'\\n  }\\n];\\n\\nexport const mockTestResults: TestResult[] = [\\n  // Test 01 - Physics Kinematics\\n  { id: \'tr-1-1\', testId: \'test-01\', studentId: \'sp-01\', marksObtained: 92, percentile: 96, remarks: \'Superb mastery of vector decompositions\' },\\n  { id: \'tr-1-2\', testId: \'test-01\', studentId: \'sp-02\', marksObtained: 85, percentile: 88 },\\n  { id: \'tr-1-3\', testId: \'test-01\', studentId: \'sp-03\', marksObtained: 46, percentile: 20, remarks: \'Struggled with free-body diagrams\' },\\n  { id: \'tr-1-4\', testId: \'test-01\', studentId: \'sp-04\', marksObtained: 96, percentile: 99, remarks: \'Highest in batch\' },\\n  { id: \'tr-1-6\', testId: \'test-01\', studentId: \'sp-06\', marksObtained: 74, percentile: 65 },\\n  { id: \'tr-1-7\', testId: \'test-01\', studentId: \'sp-07\', marksObtained: 78, percentile: 72 },\\n\\n  // Test 02 - Calculus\\n  { id: \'tr-2-1\', testId: \'test-02\', studentId: \'sp-01\', marksObtained: 89, percentile: 92, remarks: \'Flawless optimization proofs\' },\\n  { id: \'tr-2-2\', testId: \'test-02\', studentId: \'sp-02\', marksObtained: 81, percentile: 80 },\\n  { id: \'tr-2-3\', testId: \'test-02\', studentId: \'sp-03\', marksObtained: 38, percentile: 12, remarks: \'Failed passing threshold\' },\\n  { id: \'tr-2-4\', testId: \'test-02\', studentId: \'sp-04\', marksObtained: 94, percentile: 98 },\\n  { id: \'tr-2-6\', testId: \'test-02\', studentId: \'sp-06\', marksObtained: 70, percentile: 60 },\\n  { id: \'tr-2-7\', testId: \'test-02\', studentId: \'sp-07\', marksObtained: 76, percentile: 68 },\\n\\n  // Test 03 - Chemistry Kinetics\\n  { id: \'tr-3-1\', testId: \'test-03\', studentId: \'sp-01\', marksObtained: 58, percentile: 62, remarks: \'Score contraction from previous term\' },\\n  { id: \'tr-3-2\', testId: \'test-03\', studentId: \'sp-02\', ma