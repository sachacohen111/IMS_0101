            lines {
              text: "  // Compute at-risk students"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const riskStudents = students.filter(s => s.status === \'Active\').flatMap(s => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const reasons: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const studentTests = testResults.filter(r => r.studentName === s.name);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (studentTests.length > 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const last = studentTests[studentTests.length - 1];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const prev = studentTests[studentTests.length - 2];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const testLast = tests.find(t => t.id === last.testId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const testPrev = tests.find(t => t.id === prev.testId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const pLast = testLast ? Math.round((last.marksObtained / testLast.maxMarks) * 100) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const pPrev = testPrev ? Math.round((prev.marksObtained / testPrev.maxMarks) * 100) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (pLast < 40 && pPrev < 40) reasons.push(\'Below 40% twice\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      else if (pPrev - pLast >= 10) reasons.push(`Dropped ${pPrev - pLast} points`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const studentAtt = attendanceRecords.filter(a => a.studentName === s.name);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const presentAtt = studentAtt.filter(a => a.status === \'PRESENT\' || a.status === \'LATE\').length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const attPct = studentAtt.length > 0 ? Math.round((presentAtt / studentAtt.length) * 100) : 100;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (attPct < 75) reasons.push(`Attendance ${attPct}%`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return reasons.length ? [{ name: `${s.name} (${s.batchName})`, reasons: reasons.join(\'; \') }] : [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
