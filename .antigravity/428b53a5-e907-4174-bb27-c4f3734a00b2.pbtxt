      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { SeverityLevel } from \'../../types/ims\';\\nimport { AlertTriangle, AlertCircle, Info, ShieldAlert } from \'lucide-react\';\\n\\ninterface AtRiskBadgeProps {\\n  severity: SeverityLevel;\\n  category: string;\\n}\\n\\nexport const AtRiskBadge: React.FC<AtRiskBadgeProps> = ({ severity, category }) => {\\n  const getSeverityStyle = () => {\\n    switch (severity) {\\n      case \'CRITICAL\':\\n        return {\\n          textColor: \'text-rose-700 dark:text-rose-400\',\\n          borderColor: \'border-rose-200 dark:border-rose-900/60\',\\n          bgColor: \'bg-rose-50 dark:bg-rose-950/40\',\\n          icon: ShieldAlert\\n        };\\n      case \'HIGH\':\\n        return {\\n          textColor: \'text-amber-700 dark:text-amber-400\',\\n          borderColor: \'border-amber-200 dark:border-amber-900/60\',\\n          bgColor: \'bg-amber-50 dark:bg-amber-950/40\',\\n          icon: AlertTriangle\\n        };\\n      case \'MEDIUM\':\\n        return {\\n          textColor: \'text-yellow-700 dark:text-yellow-400\',\\n          borderColor: \'border-yellow-200 dark:border-yellow-900/60\',\\n          bgColor: \'bg-yellow-50 dark:bg-yellow-950/40\',\\n          icon: AlertCircle\\n        };\\n      case \'LOW\':\\n      default:\\n        return {\\n          textColor: \'text-blue-700 dark:text-blue-400\',\\n          borderColor: \'border-blue-200 dark:border-blue-900/60\',\\n          bgColor: \'bg-blue-50 dark:bg-blue-950/40\',\\n          icon: Info\\n        };\\n    }\\n  };\\n\\n  const style = getSeverityStyle();\\n  const Icon = style.icon;\\n\\n  return (\\n    <span\\n      className={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-medium border ${style.bgColor} ${style.borderColor} ${style.textColor}`}\\n    >\\n      <Icon className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n      <span>{severity}</span>\\n      <span aria-hidden=\\\"true\\\" className=\\\"opacity-40\\\">\302\267</span>\\n      <span className=\\\"font-normal opacity-90\\\">{category.replace(\'_\', \' \')}</span>\\n    </span>\\n  );\\n};\\n\", \"Description\":\"Create AtRiskBadge component with WCAG compliant severity indicators\", \"Overwrite\":true, \"TargetFile\":\"/src/components/common/AtRiskBadge.tsx\", \"toolAction\":\"Creating AtRiskBadge\", \"toolSummary\":\"Create AtRiskBadge component\"}"
