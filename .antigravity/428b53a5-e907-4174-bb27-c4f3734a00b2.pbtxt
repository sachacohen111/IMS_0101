  user_input {
    user_response: "{\n  \"project_name\": \"IMS \342\200\223 Institute Management System\",\n  \"version\": \"1.0.0-MVP\",\n  \"architecture\": {\n    \"frontend_web\": \"Next.js 14+ (App Router), React, Tailwind CSS, Lucide Icons, Recharts\",\n    \"mobile\": \"React Native (Expo) sharing TypeScript types and query hooks\",\n    \"backend\": \"Node.js / Next.js Route Handlers & Server Actions, Prisma ORM\",\n    \"database\": \"PostgreSQL 15+\",\n    \"authentication\": \"JWT-based RBAC with HTTP-only cookies and Refresh Token rotation\",\n    \"storage\": \"S3-compatible Object Storage (AWS S3 / Cloudflare R2 / Supabase Storage)\"\n  },\n  \"design_system\": {\n    \"palette\": {\n      \"primary\": \"#1E3A8A\",\n      \"primary_hover\": \"#172554\",\n      \"secondary\": \"#0D9488\",\n      \"accent_positive\": \"#16A34A\",\n      \"accent_warning\": \"#F59E0B\",\n      \"accent_danger\": \"#DC2626\",\n      \"background_light\": \"#F8FAFC\",\n      \"surface_light\": \"#FFFFFF\",\n      \"border_light\": \"#E2E8F0\",\n      \"text_primary\": \"#0F172A\",\n      \"text_secondary\": \"#475569\",\n      \"background_dark\": \"#0B1329\",\n      \"surface_dark\": \"#111C44\",\n      \"border_dark\": \"#1E293B\"\n    },\n    \"typography\": {\n      \"font_family_sans\": \"Inter, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif\",\n      \"font_family_mono\": \"JetBrains Mono, monospace\"\n    }\n  },\n  \"database_schema\": {\n    \"prisma_schema_raw\": \"datasource db {\\n  provider = \\\"postgresql\\\"\\n  url      = env(\\\"DATABASE_URL\\\")\\n}\\n\\ngenerator client {\\n  provider = \\\"prisma-client-js\\\"\\n}\\n\\nenum Role {\\n  SUPER_ADMIN\\n  ADMIN\\n  TEACHER\\n  STUDENT\\n  PARENT\\n}\\n\\nenum Gender {\\n  MALE\\n  FEMALE\\n  OTHER\\n}\\n\\nenum AttendanceStatus {\\n  PRESENT\\n  ABSENT\\n  LATE\\n  EXCUSED\\n}\\n\\nenum PaymentStatus {\\n  PAID\\n  PARTIAL\\n  DUE\\n  OVERDUE\\n}\\n\\nenum SubmissionStatus {\\n  PENDING\\n  SUBMITTED\\n  LATE\\n  EVALUATED\\n}\\n\\nenum SeverityLevel {\\n  LOW\\n  MEDIUM\\n  HIGH\\n  CRITICAL\\n}\\n\\nmodel Institute {\\n  id          String   @id @default(uuid())\\n  name        String\\n  code        String   @unique\\n  address     String?\\n  phone       String?\\n  email       String   @unique\\n  logoUrl     String?\\n  createdAt   DateTime @default(now())\\n  updatedAt   DateTime @updatedAt\\n\\n  users       User[]\\n  courses     Course[]\\n  batches     Batch[]\\n  notices     Notice[]\\n  feePlans    FeeStructure[]\\n}\\n\\nmodel User {\\n  id           String    @id @default(uuid())\\n  instituteId  String\\n  email        String    @unique\\n  passwordHash String\\n  role         Role\\n  firstName    String\\n  lastName     String\\n  phone        String?\\n  avatarUrl    String?\\n  isActive     Boolean   @default(true)\\n  createdAt    DateTime  @default(now())\\n  updatedAt    DateTime  @updatedAt\\n\\n  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  teacherProfile TeacherProfile?\\n  studentProfile StudentProfile?\\n  parentProfile  ParentProfile?\\n  authoredNotices Notice[] @relation(\\\"NoticeAuthor\\\")\\n  notifications Notification[]\\n}\\n\\nmodel TeacherProfile {\\n  id             String   @id @default(uuid())\\n  userId         String   @unique\\n  employeeCode   String   @unique\\n  qualification  String?\\n  specialization String?\\n  joiningDate    DateTime @default(now())\\n\\n  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)\\n  batchSubjects  BatchSubjectTeacher[]\\n  createdTests   Test[]\\n  createdTasks   ImprovementPlanTask[]\\n}\\n\\nmodel ParentProfile {\\n  id         String   @id @default(uuid())\\n  userId     String   @unique\\n  occupation String?\\n\\n  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)\\n  children   StudentProfile[]\\n}\\n\\nmodel StudentProfile {\\n  id              String        @id @default(uuid())\\n  userId          String        @unique\\n  parentId        String?\\n  batchId         String\\n  rollNumber      String\\n  admissionNumber String        @unique\\n  admissionDate   DateTime      @default(now())\\n  dateOfBirth     DateTime?\\n  gender          Gender        @default(MALE)\\n  bloodGroup      String?\\n  address         String?\\n  currentStreak   Int           @default(0)\\n  highestStreak   Int           @default(0)\\n  badgePoints     Int           @default(0)\\n\\n  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)\\n  parent          ParentProfile? @relation(fields: [parentId], references: [id], onDelete: SetNull)\\n  batch           Batch         @relation(fields: [batchId], references: [id])\\n  attendanceRecords AttendanceRecord[]\\n  testMarks       TestResult[]\\n  homeworkSubmissions HomeworkSubmission[]\\n  invoices        FeeInvoice[]\\n  performanceAlerts PerformanceAlert[]\\n  improvementPlans ImprovementPlan[]\\n  remarks         StudentRemark[]\\n}\\n\\nmodel Course {\\n  id          String   @id @default(uuid())\\n  instituteId String\\n  name        String\\n  code        String\\n  description String?\\n\\n  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  subjects    Subject[]\\n  batches     Batch[]\\n\\n  @@unique([instituteId, code])\\n}\\n\\nmodel Subject {\\n  id          String   @id @default(uuid())\\n  courseId    String\\n  name        String\\n  code        String\\n\\n  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)\\n  batchSubjects BatchSubjectTeacher[]\\n  tests       Test[]\\n  homeworks   Homework[]\\n}\\n\\nmodel Batch {\\n  id          String   @id @default(uuid())\\n  instituteId String\\n  courseId    String\\n  name        String\\n  startDate   DateTime\\n  endDate     DateTime?\\n  maxCapacity Int      @default(50)\\n\\n  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  course      Course    @relation(fields: [courseId], references: [id])\\n  students    StudentProfile[]\\n  batchSubjects BatchSubjectTeacher[]\\n  timetables  TimetableSlot[]\\n  attendanceSessions AttendanceSession[]\\n  tests       Test[]\\n  homeworks   Homework[]\\n}\\n\\nmodel BatchSubjectTeacher {\\n  id          String   @id @default(uuid())\\n  batchId     String\\n  subjectId   String\\n  teacherId   String\\n\\n  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)\\n  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)\\n\\n  @@unique([batchId, subjectId])\\n}\\n\\nmodel TimetableSlot {\\n  id        String   @id @default(uuid())\\n  batchId   String\\n  dayOfWeek Int\\n  startTime String\\n  endTime   String\\n  subjectName String\\n  classroom String?\\n\\n  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n}\\n\\nmodel AttendanceSession {\\n  id        String   @id @default(uuid())\\n  batchId   String\\n  date      DateTime\\n  takenById String\\n  createdAt DateTime @default(now())\\n\\n  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n  records   AttendanceRecord[]\\n\\n  @@unique([batchId, date])\\n}\\n\\nmodel AttendanceRecord {\\n  id          String           @id @default(uuid())\\n  sessionId   String\\n  studentId   String\\n  status      AttendanceStatus @default(PRESENT)\\n  remarks     String?\\n\\n  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)\\n  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n\\n  @@unique([sessionId, studentId])\\n}\\n\\nmodel Test {\\n  id          String   @id @default(uuid())\\n  batchId     String\\n  subjectId   String\\n  teacherId   String\\n  title       String\\n  maxMarks    Float\\n  passingMarks Float\\n  testDate    DateTime\\n  createdAt   DateTime @default(now())\\n\\n  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n  subject     Subject  @relation(fields: [subjectId], references: [id])\\n  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])\\n  results     TestResult[]\\n}\\n\\nmodel TestResult {\\n  id         String   @id @default(uuid())\\n  testId     String\\n  studentId  String\\n  marksObtained Float\\n  percentile Float? \\n  remarks    String?\\n\\n  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)\\n  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n\\n  @@unique([testId, studentId])\\n}\\n\\nmodel Homework {\\n  id          String   @id @default(uuid())\\n  batchId     String\\n  subjectId   String\\n  title       String\\n  description String\\n  dueDate     DateTime\\n  createdAt   DateTime @default(now())\\n\\n  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n  subject     Subject  @relation(fields: [subjectId], references: [id])\\n  submissions HomeworkSubmission[]\\n}\\n\\nmodel HomeworkSubmission {\\n  id           String           @id @default(uuid())\\n  homeworkId   String\\n  studentId    String\\n  submissionDate DateTime       @default(now())\\n  fileUrl      String?\\n  status       SubmissionStatus @default(SUBMITTED)\\n  grade        String?\\n  feedback     String?\\n\\n  homework     Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)\\n  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n\\n  @@unique([homeworkId, studentId])\\n}\\n\\nmodel FeeStructure {\\n  id          String   @id @default(uuid())\\n  instituteId String\\n  name        String\\n  totalAmount Float\\n  dueInterval String\\n\\n  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  invoices    FeeInvoice[]\\n}\\n\\nmodel FeeInvoice {\\n  id             String        @id @default(uuid())\\n  studentId      String\\n  feeStructureId String?\\n  title          String\\n  amount         Float\\n  paidAmount     Float         @default(0)\\n  dueDate        DateTime\\n  status         PaymentStatus @default(DUE)\\n  createdAt      DateTime      @default(now())\\n\\n  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n  feeStructure   FeeStructure?  @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)\\n}\\n\\nmodel PerformanceAlert {\\n  id          String        @id @default(uuid())\\n  studentId   String\\n  category    String\\n  title       String\\n  message     String\\n  severity    SeverityLevel @default(MEDIUM)\\n  isResolved  Boolean       @default(false)\\n  createdAt   DateTime      @default(now())\\n\\n  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n}\\n\\nmodel ImprovementPlan {\\n  id          String   @id @default(uuid())\\n  studentId   String\\n  subjectName String\\n  focusArea   String\\n  targetScore Float\\n  deadline    DateTime\\n  status      String   @default(\\\"IN_PROGRESS\\\")\\n  createdAt   DateTime @default(now())\\n\\n  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n  tasks       ImprovementPlanTask[]\\n}\\n\\nmodel ImprovementPlanTask {\\n  id        String          @id @default(uuid())\\n  planId    String\\n  assignedById String\\n  title     String\\n  isDone    Boolean         @default(false)\\n\\n  plan      ImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)\\n  assignedBy TeacherProfile @relation(fields: [assignedById], references: [id])\\n}\\n\\nmodel StudentRemark {\\n  id         String   @id @default(uuid())\\n  studentId  String\\n  authorName String\\n  category   String\\n  comment    String\\n  createdAt  DateTime @default(now())\\n\\n  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n}\\n\\nmodel Notice {\\n  id          String   @id @default(uuid())\\n  instituteId String\\n  authorId    String\\n  title       String\\n  content     String\\n  targetRole  Role?\\n  createdAt   DateTime @default(now())\\n\\n  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  author      User      @relation(\\\"NoticeAuthor\\\", fields: [authorId], references: [id])\\n}\\n\\nmodel Notification {\\n  id        String   @id @default(uuid())\\n  userId    String\\n  title     String\\n  body      String\\n  link      String?\\n  isRead    Boolean  @default(false)\\n  createdAt DateTime @default(now())\\n\\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\\n}\"\n  },\n  \"authentication_and_rbac\": {\n    \"rbac_matrix\": {\n      \"SUPER_ADMIN\": [\"institute:write\", \"analytics:global\", \"branch:manage\", \"billing:manage\", \"staff:manage\", \"students:manage\", \"notices:publish\"],\n      \"ADMIN\": [\"staff:manage\", \"students:manage\", \"batches:manage\", \"fees:manage\", \"timetable:manage\", \"reports:generate\", \"notices:publish\"],\n      \"TEACHER\": [\"attendance:mark\", \"marks:entry\", \"homework:create\", \"improvement_plan:manage\", \"remarks:create\", \"analytics:batch\"],\n      \"STUDENT\": [\"self_profile:view\", \"attendance:view\", \"results:view\", \"homework:submit\", \"timetable:view\", \"goals:view\"],\n      \"PARENT\": [\"child_profile:view\", \"child_attendance:view\", \"child_results:view\", \"fees:view_pay\", \"feedback:submit\"]\n    },\n    \"jwt_payload_structure\": {\n      \"sub\": \"user_uuid\",\n      \"instituteId\": \"institute_uuid\",\n      \"role\": \"SUPER_ADMIN | ADMIN | TEACHER | STUDENT | PARENT\",\n      \"email\": \"user@ims.edu\",\n      \"profileId\": \"profile_uuid_or_null\",\n      \"iat\": 1700000000,\n      \"exp\": 1700086400\n    },\n    \"middleware_logic_pseudocode\": \"export async function middleware(req: NextRequest) {\\n  const token = req.cookies.get(\'token\')?.value || req.headers.get(\'Authorization\')?.replace(\'Bearer \', \'\');\\n  if (!token) return NextResponse.json({ error: \'Unauthenticated\' }, { status: 401 });\\n  try {\\n    const payload = verifyJWT(token);\\n    const { pathname } = req.nextUrl;\\n    if (pathname.startsWith(\'/api/admin\') && ![\'SUPER_ADMIN\', \'ADMIN\'].includes(payload.role)) {\\n      return NextResponse.json({ error: \'Forbidden\' }, { status: 403 });\\n    }\\n    if (pathname.startsWith(\'/api/teacher\') && ![\'SUPER_ADMIN\', \'ADMIN\', \'TEACHER\'].includes(payload.role)) {\\n      return NextResponse.json({ error: \'Forbidden\' }, { status: 403 });\\n    }\\n    const requestHeaders = new Headers(req.headers);\\n    requestHeaders.set(\'x-user-id\', payload.sub);\\n    requestHeaders.set(\'x-institute-id\', payload.instituteId);\\n    requestHeaders.set(\'x-user-role\', payload.role);\\n    return NextResponse.next({ request: { headers: requestHeaders } });\\n  } catch (err) {\\n    return NextResponse.json({ error: \'Invalid or expired token\' }, { status: 401 });\\n  }\\n}\"\n  },\n  \"api_endpoints\": [\n    {\n      \"group\": \"Authentication\",\n      \"routes\": [\n        { \"method\": \"POST\", \"path\": \"/api/auth/login\", \"auth\": false, \"roles\": [\"ALL\"], \"description\": \"Authenticates credentials and returns JWT plus role profile context.\" },\n        { \"method\": \"GET\", \"path\": \"/api/auth/me\", \"auth\": true, \"roles\": [\"ALL\"], \"description\": \"Retrieves currently logged in user context and linked entity profile.\" },\n        { \"method\": \"POST\", \"path\": \"/api/auth/logout\", \"auth\": true, \"roles\": [\"ALL\"], \"description\": \"Clears auth cookies and invalidates session token.\" }\n      ]\n    },\n    {\n      \"group\": \"Institute Management & Batches\",\n      \"routes\": [\n        { \"method\": \"GET\", \"path\": \"/api/courses\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"List all courses with linked subjects.\" },\n        { \"method\": \"POST\", \"path\": \"/api/courses\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Create course with subject catalog.\" },\n        { \"method\": \"GET\", \"path\": \"/api/batches\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"List batches with student count and subject-teacher mapping.\" },\n        { \"method\": \"POST\", \"path\": \"/api/batches\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Create new batch and assign course.\" }\n      ]\n    },\n    {\n      \"group\": \"Student & Staff Management\",\n      \"routes\": [\n        { \"method\": \"GET\", \"path\": \"/api/students\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Paginated search & filter of students by batch, status, and search query.\" },\n        { \"method\": \"POST\", \"path\": \"/api/students\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Enroll a student, create user record, link to batch & guardian.\" },\n        { \"method\": \"GET\", \"path\": \"/api/students/:id/profile\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"], \"description\": \"Returns full 360-degree student performance snapshot and timeline.\" },\n        { \"method\": \"GET\", \"path\": \"/api/teachers\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"List all teacher profiles, active batches, and assigned subjects.\" }\n      ]\n    },\n    {\n      \"group\": \"Attendance\",\n      \"routes\": [\n        { \"method\": \"POST\", \"path\": \"/api/attendance/mark\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Bulk submit attendance for an entire batch for a specified date.\" },\n        { \"method\": \"GET\", \"path\": \"/api/attendance/batch/:batchId\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Get date-wise batch attendance matrix.\" },\n        { \"method\": \"GET\", \"path\": \"/api/attendance/student/:studentId\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"], \"description\": \"Get student attendance percentage, daily list, and streaks.\" }\n      ]\n    },\n    {\n      \"group\": \"Exams & Results\",\n      \"routes\": [\n        { \"method\": \"POST\", \"path\": \"/api/tests\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Schedule a test for a batch with subject and maximum marks.\" },\n        { \"method\": \"POST\", \"path\": \"/api/tests/:testId/marks\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Enter and commit marks for all students in the test.\" },\n        { \"method\": \"GET\", \"path\": \"/api/tests/batch/:batchId\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Fetch test list with average performance statistics.\" }\n      ]\n    },\n    {\n      \"group\": \"Analytics & Performance Engine\",\n      \"routes\": [\n        { \"method\": \"GET\", \"path\": \"/api/analytics/institute-summary\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Aggregate KPI stats: total admissions, collections, attendance rate, at-risk flags.\" },\n        { \"method\": \"GET\", \"path\": \"/api/analytics/student/:studentId/intelligence\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"], \"description\": \"Calculates subject strengths, weak spots, trajectory curves, and automated improvement tasks.\" },\n        { \"method\": \"POST\", \"path\": \"/api/analytics/improvement-plans\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Create remediation target plan for a weak student.\" }\n      ]\n    },\n    {\n      \"group\": \"Fee Operations\",\n      \"routes\": [\n        { \"method\": \"GET\", \"path\": \"/api/fees/invoices\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"List fee invoices with status, overdue counts, and date filters.\" },\n        { \"method\": \"POST\", \"path\": \"/api/fees/collect\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Record manual or offline fee collection against an invoice.\" }\n      ]\n    }\n  ],\n  \"page_and_screen_hierarchy\": {\n    \"SUPER_ADMIN\": {\n      \"web_routes\": [\n        { \"path\": \"/super-admin/dashboard\", \"title\": \"Executive Overview\", \"widgets\": [\"Institute KPI Strip\", \"Enrollment vs Dropout Line Chart\", \"Revenue Collections Bar Chart\", \"Academic Health Index Heatmap\"] },\n        { \"path\": \"/super-admin/institutes\", \"title\": \"Branches & Settings\", \"widgets\": [\"Branch Selector\", \"Global Plan Limits\", \"API Webhook Integrations\"] },\n        { \"path\": \"/super-admin/audit-logs\", \"title\": \"System Audit Trail\", \"widgets\": [\"Realtime Action Logs\", \"Security Auth Exceptions\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"SuperAdminOverviewScreen\", \"title\": \"IMS Executive Mobile\", \"components\": [\"SummaryCards\", \"QuickRevenueWidget\", \"EmergencyNoticeDispatcher\"] }\n      ]\n    },\n    \"ADMIN\": {\n      \"web_routes\": [\n        { \"path\": \"/admin/dashboard\", \"title\": \"Operations Dashboard\", \"widgets\": [\"Today\'s Attendance Rate\", \"Active Batches\", \"Fee Dues Pending\", \"High Priority At-Risk Alerts\"] },\n        { \"path\": \"/admin/students\", \"title\": \"Student Directory\", \"widgets\": [\"Data Table with Multi-Filter\", \"Batch Transfer Modal\", \"Admission Wizard Button\"] },\n        { \"path\": \"/admin/teachers\", \"title\": \"Faculty Management\", \"widgets\": [\"Workload Distribution Cards\", \"Teacher Subject Mapping Table\"] },\n        { \"path\": \"/admin/batches\", \"title\": \"Batch & Timetable Manager\", \"widgets\": [\"Weekly Scheduler Matrix\", \"Capacity Utilization Gauges\"] },\n        { \"path\": \"/admin/fees\", \"title\": \"Fee Management Hub\", \"widgets\": [\"Defaulter List Table\", \"Payment Collection Drawer\", \"Aging Report Chart\"] },\n        { \"path\": \"/admin/notices\", \"title\": \"Notice Board Center\", \"widgets\": [\"Composer with Role Target Selector\", \"Published Circulars Feed\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"AdminDashboardScreen\", \"title\": \"Ops Hub\", \"components\": [\"AttendanceDonut\", \"DefaulterQuickStrip\", \"RecentAdmissionsList\"] },\n        { \"screen\": \"AdminStudentListScreen\", \"title\": \"Find Student\", \"components\": [\"FastSearchInput\", \"StudentMiniCardWithPhoneDial\"] }\n      ]\n    },\n    \"TEACHER\": {\n      \"web_routes\": [\n        { \"path\": \"/teacher/dashboard\", \"title\": \"Teacher Workspace\", \"widgets\": [\"Today\'s Schedule Cards\", \"Pending Homework Grading\", \"Weak Student Radar Alert\"] },\n        { \"path\": \"/teacher/attendance\", \"title\": \"Daily Roll Call\", \"widgets\": [\"Batch Dropdown\", \"Fast One-Click Present/Absent/Late Toggles\", \"Streak Auto-Calculator\"] },\n        { \"path\": \"/teacher/marks\", \"title\": \"Gradebook & Test Entry\", \"widgets\": [\"Test Creator Drawer\", \"Bulk Marks Input Spreadsheet Grid\", \"Live Bell-Curve Distribution Chart\"] },\n        { \"path\": \"/teacher/homework\", \"title\": \"Homework Assignments\", \"widgets\": [\"Assignment Creator Form\", \"Submission Review List with Grade Input\"] },\n        { \"path\": \"/teacher/remediation\", \"title\": \"Intervention & Improvement\", \"widgets\": [\"AI Suggested Remediation Plans\", \"Task Assignment Checklist\", \"Parent Note Composer\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"TeacherAttendanceScreen\", \"title\": \"Quick Roll Call\", \"components\": [\"FastSwipeableStudentCards\", \"SubmitAttendanceFloatingButton\"] },\n        { \"screen\": \"TeacherGradeEntryScreen\", \"title\": \"Enter Test Marks\", \"components\": [\"CompactMarkInputRow\", \"ClassAverageLiveBadge\"] }\n      ]\n    },\n    \"STUDENT\": {\n      \"web_routes\": [\n        { \"path\": \"/student/dashboard\", \"title\": \"Student Learning Dashboard\", \"widgets\": [\"Academic Streak Counter\", \"Upcoming Tests & Timetable\", \"Subject Mastery Radial Progress\", \"Recent Badges Won\"] },\n        { \"path\": \"/student/performance\", \"title\": \"My Performance Analytics\", \"widgets\": [\"Score Growth Trajectory Line Chart\", \"Class vs Self Comparison Bar Chart\", \"Subject Weakness Drilldown\"] },\n        { \"path\": \"/student/homework\", \"title\": \"Homework & Tasks\", \"widgets\": [\"Pending Homework Kanban\", \"Document Upload Form\", \"Past Grades & Teacher Feedback\"] },\n        { \"path\": \"/student/timeline\", \"title\": \"My Journey Timeline\", \"widgets\": [\"Chronological Feed of Test Scores, Awards, Remarks and Badges\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"StudentHomeScreen\", \"title\": \"Student Pulse\", \"components\": [\"StreakFireWidget\", \"TodayClassList\", \"SubjectMasteryBars\"] },\n        { \"screen\": \"StudentResultsScreen\", \"title\": \"Report Card\", \"components\": [\"ScoreTrendChart\", \"RecentExamAccordion\"] }\n      ]\n    },\n    \"PARENT\": {\n      \"web_routes\": [\n        { \"path\": \"/parent/dashboard\", \"title\": \"Ward Overview\", \"widgets\": [\"Attendance Rate Gauge\", \"Latest Exam Grades\", \"Teacher Remarks Feed\", \"Fee Invoices Due Notification\"] },\n        { \"path\": \"/parent/reports\", \"title\": \"Child Academic Diagnostics\", \"widgets\": [\"Plain-English Summary Card\", \"Subject Confidence Level Chart\", \"Remediation Action Items Assigned to Child\"] },\n        { \"path\": \"/parent/fees\", \"title\": \"Fee Ledger\", \"widgets\": [\"Pending Invoices Table\", \"Receipt Downloader Button\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"ParentOverviewScreen\", \"title\": \"Ward Progress\", \"components\": [\"ChildProfileHeader\", \"AttendanceMiniDial\", \"ExamScoreCard\", \"PayFeeStickyBar\"] }\n      ]\n    }\n  },\n  \"ui_component_library\": {\n    \"components\": [\n      {\n        \"name\": \"StatCard\",\n        \"props\": [\"title: string\", \"value: string | number\", \"change: number\", \"trend: \'up\' | \'down\' | \'neutral\'\", \"icon: LucideIcon\", \"accentColor?: string\"],\n        \"description\": \"Renders high-level KPI card with change metric indicator and colored badge.\"\n      },\n      {\n        \"name\": \"PerformanceTrendChart\",\n        \"props\": [\"data: Array<{ testName: string, studentScore: number, classAverage: number }>\", \"height?: number\"],\n        \"description\": \"Dual-line interactive Recharts component showing individual progression compared against class mean.\"\n      },\n      {\n        \"name\": \"AttendanceHeatmap\",\n        \"props\": [\"records: Array<{ date: string, status: \'PRESENT\' | \'ABSENT\' | \'LATE\' | \'EXCUSED\' }>\"],\n        \"description\": \"GitHub-style month-by-month square activity matrix visualizing student presence.\"\n      },\n      {\n        \"name\": \"AtRiskBadge\",\n        \"props\": [\"severity: \'LOW\' | \'MEDIUM\' | \'HIGH\' | \'CRITICAL\'\", \"category: string\"],\n        \"description\": \"Pulsing tag component that draws immediate faculty attention to struggling or chronically absent students.\"\n      },\n      {\n        \"name\": \"FastAttendanceGrid\",\n        \"props\": [\"students: Student[]\", \"initialStatus?: Record<string, \'PRESENT\'|\'ABSENT\'|\'LATE\'>\", \"onSave: (records: Record<string, string>) => void\"],\n        \"description\": \"Optimized batch attendance taker with keyboard navigation, hotkeys (P/A/L), and multi-select toggles.\"\n      },\n      {\n        \"name\": \"BadgeShowcase\",\n        \"props\": [\"badges: Array<{ id: string, name: string, earnedAt: string, icon: string, description: string }>\"],\n        \"description\": \"Gamification widget displaying earned academic milestones, attendance streaks, and rank badges.\"\n      }\n    ]\n  },\n  \"performance_engine_algorithms\": {\n    \"rules\": {\n      \"low_attendance_threshold_percentage\": 75.0,\n      \"academic_drop_threshold_percentage\": 15.0,\n      \"homework_consecutive_misses_limit\": 3\n    },\n    \"analytics_service_implementation_ts\": \"export interface StudentDiagnosticResult {\\n  studentId: string;\\n  overallAverage: number;\\n  classAverageDelta: number;\\n  attendanceRate: number;\\n  subjectWeaknesses: Array<{ subject: string; average: number; targetGap: number }>;\\n  subjectStrengths: Array<{ subject: string; average: number }>;\\n  flags: Array<{\\n    category: \'ATTENDANCE\' | \'ACADEMIC_DROP\' | \'HOMEWORK\' | \'CHRONIC_WEAKNESS\';\\n    severity: \'LOW\' | \'MEDIUM\' | \'HIGH\' | \'CRITICAL\';\\n    message: string;\\n  }>;\\n  automatedRecommendations: string[];\\n}\\n\\nexport function computeStudentDiagnostics(\\n  studentTests: Array<{ subjectName: string; marksObtained: number; maxMarks: number; testDate: Date; classAveragePct: number }>,\\n  attendanceRecords: Array<{ status: \'PRESENT\' | \'ABSENT\' | \'LATE\' | \'EXCUSED\' }>,\\n  pendingHomeworkCount: number\\n): StudentDiagnosticResult {\\n  const flags: StudentDiagnosticResult[\'flags\'] = [];\\n  const recommendations: string[] = [];\\n\\n  // 1. Attendance Analysis\\n  const totalSessions = attendanceRecords.length;\\n  const presentCount = attendanceRecords.filter(r => r.status === \'PRESENT\' || r.status === \'LATE\').length;\\n  const attendanceRate = totalSessions > 0 ? (presentCount / totalSessions) * 100 : 100;\\n\\n  if (attendanceRate < 75.0) {\\n    flags.push({\\n      category: \'ATTENDANCE\',\\n      severity: attendanceRate < 60.0 ? \'CRITICAL\' : \'HIGH\',\\n      message: `Attendance is dangerously low at ${attendanceRate.toFixed(1)}%. Missed lessons directly impact upcoming exams.`\\n    });\\n    recommendations.push(\'Schedule mandatory parental counseling regarding classroom absenteeism.\');\\n  }\\n\\n  // 2. Subject Breakdown\\n  const subjectMap = new Map<string, { totalPct: number; count: number; recentScores: number[] }>();\\n  for (const t of studentTests) {\\n    const pct = (t.marksObtained / t.maxMarks) * 100;\\n    const existing = subjectMap.get(t.subjectName) || { totalPct: 0, count: 0, recentScores: [] };\\n    existing.totalPct += pct;\\n    existing.count += 1;\\n    existing.recentScores.push(pct);\\n    subjectMap.set(t.subjectName, existing);\\n  }\\n\\n  const subjectWeaknesses: StudentDiagnosticResult[\'subjectWeaknesses\'] = [];\\n  const subjectStrengths: StudentDiagnosticResult[\'subjectStrengths\'] = [];\\n  let sumAverages = 0;\\n\\n  subjectMap.forEach((val, subject) => {\\n    const avg = val.totalPct / val.count;\\n    sumAverages += avg;\\n\\n    if (avg < 50.0) {\\n      subjectWeaknesses.push({ subject, average: avg,"
    items {
      text: "{\n  \"project_name\": \"IMS \342\200\223 Institute Management System\",\n  \"version\": \"1.0.0-MVP\",\n  \"architecture\": {\n    \"frontend_web\": \"Next.js 14+ (App Router), React, Tailwind CSS, Lucide Icons, Recharts\",\n    \"mobile\": \"React Native (Expo) sharing TypeScript types and query hooks\",\n    \"backend\": \"Node.js / Next.js Route Handlers & Server Actions, Prisma ORM\",\n    \"database\": \"PostgreSQL 15+\",\n    \"authentication\": \"JWT-based RBAC with HTTP-only cookies and Refresh Token rotation\",\n    \"storage\": \"S3-compatible Object Storage (AWS S3 / Cloudflare R2 / Supabase Storage)\"\n  },\n  \"design_system\": {\n    \"palette\": {\n      \"primary\": \"#1E3A8A\",\n      \"primary_hover\": \"#172554\",\n      \"secondary\": \"#0D9488\",\n      \"accent_positive\": \"#16A34A\",\n      \"accent_warning\": \"#F59E0B\",\n      \"accent_danger\": \"#DC2626\",\n      \"background_light\": \"#F8FAFC\",\n      \"surface_light\": \"#FFFFFF\",\n      \"border_light\": \"#E2E8F0\",\n      \"text_primary\": \"#0F172A\",\n      \"text_secondary\": \"#475569\",\n      \"background_dark\": \"#0B1329\",\n      \"surface_dark\": \"#111C44\",\n      \"border_dark\": \"#1E293B\"\n    },\n    \"typography\": {\n      \"font_family_sans\": \"Inter, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif\",\n      \"font_family_mono\": \"JetBrains Mono, monospace\"\n    }\n  },\n  \"database_schema\": {\n    \"prisma_schema_raw\": \"datasource db {\\n  provider = \\\"postgresql\\\"\\n  url      = env(\\\"DATABASE_URL\\\")\\n}\\n\\ngenerator client {\\n  provider = \\\"prisma-client-js\\\"\\n}\\n\\nenum Role {\\n  SUPER_ADMIN\\n  ADMIN\\n  TEACHER\\n  STUDENT\\n  PARENT\\n}\\n\\nenum Gender {\\n  MALE\\n  FEMALE\\n  OTHER\\n}\\n\\nenum AttendanceStatus {\\n  PRESENT\\n  ABSENT\\n  LATE\\n  EXCUSED\\n}\\n\\nenum PaymentStatus {\\n  PAID\\n  PARTIAL\\n  DUE\\n  OVERDUE\\n}\\n\\nenum SubmissionStatus {\\n  PENDING\\n  SUBMITTED\\n  LATE\\n  EVALUATED\\n}\\n\\nenum SeverityLevel {\\n  LOW\\n  MEDIUM\\n  HIGH\\n  CRITICAL\\n}\\n\\nmodel Institute {\\n  id          String   @id @default(uuid())\\n  name        String\\n  code        String   @unique\\n  address     String?\\n  phone       String?\\n  email       String   @unique\\n  logoUrl     String?\\n  createdAt   DateTime @default(now())\\n  updatedAt   DateTime @updatedAt\\n\\n  users       User[]\\n  courses     Course[]\\n  batches     Batch[]\\n  notices     Notice[]\\n  feePlans    FeeStructure[]\\n}\\n\\nmodel User {\\n  id           String    @id @default(uuid())\\n  instituteId  String\\n  email        String    @unique\\n  passwordHash String\\n  role         Role\\n  firstName    String\\n  lastName     String\\n  phone        String?\\n  avatarUrl    String?\\n  isActive     Boolean   @default(true)\\n  createdAt    DateTime  @default(now())\\n  updatedAt    DateTime  @updatedAt\\n\\n  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  teacherProfile TeacherProfile?\\n  studentProfile StudentProfile?\\n  parentProfile  ParentProfile?\\n  authoredNotices Notice[] @relation(\\\"NoticeAuthor\\\")\\n  notifications Notification[]\\n}\\n\\nmodel TeacherProfile {\\n  id             String   @id @default(uuid())\\n  userId         String   @unique\\n  employeeCode   String   @unique\\n  qualification  String?\\n  specialization String?\\n  joiningDate    DateTime @default(now())\\n\\n  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)\\n  batchSubjects  BatchSubjectTeacher[]\\n  createdTests   Test[]\\n  createdTasks   ImprovementPlanTask[]\\n}\\n\\nmodel ParentProfile {\\n  id         String   @id @default(uuid())\\n  userId     String   @unique\\n  occupation String?\\n\\n  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)\\n  children   StudentProfile[]\\n}\\n\\nmodel StudentProfile {\\n  id              String        @id @default(uuid())\\n  userId          String        @unique\\n  parentId        String?\\n  batchId         String\\n  rollNumber      String\\n  admissionNumber String        @unique\\n  admissionDate   DateTime      @default(now())\\n  dateOfBirth     DateTime?\\n  gender          Gender        @default(MALE)\\n  bloodGroup      String?\\n  address         String?\\n  currentStreak   Int           @default(0)\\n  highestStreak   Int           @default(0)\\n  badgePoints     Int           @default(0)\\n\\n  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)\\n  parent          ParentProfile? @relation(fields: [parentId], references: [id], onDelete: SetNull)\\n  batch           Batch         @relation(fields: [batchId], references: [id])\\n  attendanceRecords AttendanceRecord[]\\n  testMarks       TestResult[]\\n  homeworkSubmissions HomeworkSubmission[]\\n  invoices        FeeInvoice[]\\n  performanceAlerts PerformanceAlert[]\\n  improvementPlans ImprovementPlan[]\\n  remarks         StudentRemark[]\\n}\\n\\nmodel Course {\\n  id          String   @id @default(uuid())\\n  instituteId String\\n  name        String\\n  code        String\\n  description String?\\n\\n  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  subjects    Subject[]\\n  batches     Batch[]\\n\\n  @@unique([instituteId, code])\\n}\\n\\nmodel Subject {\\n  id          String   @id @default(uuid())\\n  courseId    String\\n  name        String\\n  code        String\\n\\n  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)\\n  batchSubjects BatchSubjectTeacher[]\\n  tests       Test[]\\n  homeworks   Homework[]\\n}\\n\\nmodel Batch {\\n  id          String   @id @default(uuid())\\n  instituteId String\\n  courseId    String\\n  name        String\\n  startDate   DateTime\\n  endDate     DateTime?\\n  maxCapacity Int      @default(50)\\n\\n  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  course      Course    @relation(fields: [courseId], references: [id])\\n  students    StudentProfile[]\\n  batchSubjects BatchSubjectTeacher[]\\n  timetables  TimetableSlot[]\\n  attendanceSessions AttendanceSession[]\\n  tests       Test[]\\n  homeworks   Homework[]\\n}\\n\\nmodel BatchSubjectTeacher {\\n  id          String   @id @default(uuid())\\n  batchId     String\\n  subjectId   String\\n  teacherId   String\\n\\n  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)\\n  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)\\n\\n  @@unique([batchId, subjectId])\\n}\\n\\nmodel TimetableSlot {\\n  id        String   @id @default(uuid())\\n  batchId   String\\n  dayOfWeek Int\\n  startTime String\\n  endTime   String\\n  subjectName String\\n  classroom String?\\n\\n  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n}\\n\\nmodel AttendanceSession {\\n  id        String   @id @default(uuid())\\n  batchId   String\\n  date      DateTime\\n  takenById String\\n  createdAt DateTime @default(now())\\n\\n  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n  records   AttendanceRecord[]\\n\\n  @@unique([batchId, date])\\n}\\n\\nmodel AttendanceRecord {\\n  id          String           @id @default(uuid())\\n  sessionId   String\\n  studentId   String\\n  status      AttendanceStatus @default(PRESENT)\\n  remarks     String?\\n\\n  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)\\n  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n\\n  @@unique([sessionId, studentId])\\n}\\n\\nmodel Test {\\n  id          String   @id @default(uuid())\\n  batchId     String\\n  subjectId   String\\n  teacherId   String\\n  title       String\\n  maxMarks    Float\\n  passingMarks Float\\n  testDate    DateTime\\n  createdAt   DateTime @default(now())\\n\\n  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n  subject     Subject  @relation(fields: [subjectId], references: [id])\\n  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])\\n  results     TestResult[]\\n}\\n\\nmodel TestResult {\\n  id         String   @id @default(uuid())\\n  testId     String\\n  studentId  String\\n  marksObtained Float\\n  percentile Float? \\n  remarks    String?\\n\\n  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)\\n  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n\\n  @@unique([testId, studentId])\\n}\\n\\nmodel Homework {\\n  id          String   @id @default(uuid())\\n  batchId     String\\n  subjectId   String\\n  title       String\\n  description String\\n  dueDate     DateTime\\n  createdAt   DateTime @default(now())\\n\\n  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)\\n  subject     Subject  @relation(fields: [subjectId], references: [id])\\n  submissions HomeworkSubmission[]\\n}\\n\\nmodel HomeworkSubmission {\\n  id           String           @id @default(uuid())\\n  homeworkId   String\\n  studentId    String\\n  submissionDate DateTime       @default(now())\\n  fileUrl      String?\\n  status       SubmissionStatus @default(SUBMITTED)\\n  grade        String?\\n  feedback     String?\\n\\n  homework     Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)\\n  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n\\n  @@unique([homeworkId, studentId])\\n}\\n\\nmodel FeeStructure {\\n  id          String   @id @default(uuid())\\n  instituteId String\\n  name        String\\n  totalAmount Float\\n  dueInterval String\\n\\n  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  invoices    FeeInvoice[]\\n}\\n\\nmodel FeeInvoice {\\n  id             String        @id @default(uuid())\\n  studentId      String\\n  feeStructureId String?\\n  title          String\\n  amount         Float\\n  paidAmount     Float         @default(0)\\n  dueDate        DateTime\\n  status         PaymentStatus @default(DUE)\\n  createdAt      DateTime      @default(now())\\n\\n  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n  feeStructure   FeeStructure?  @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)\\n}\\n\\nmodel PerformanceAlert {\\n  id          String        @id @default(uuid())\\n  studentId   String\\n  category    String\\n  title       String\\n  message     String\\n  severity    SeverityLevel @default(MEDIUM)\\n  isResolved  Boolean       @default(false)\\n  createdAt   DateTime      @default(now())\\n\\n  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n}\\n\\nmodel ImprovementPlan {\\n  id          String   @id @default(uuid())\\n  studentId   String\\n  subjectName String\\n  focusArea   String\\n  targetScore Float\\n  deadline    DateTime\\n  status      String   @default(\\\"IN_PROGRESS\\\")\\n  createdAt   DateTime @default(now())\\n\\n  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n  tasks       ImprovementPlanTask[]\\n}\\n\\nmodel ImprovementPlanTask {\\n  id        String          @id @default(uuid())\\n  planId    String\\n  assignedById String\\n  title     String\\n  isDone    Boolean         @default(false)\\n\\n  plan      ImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)\\n  assignedBy TeacherProfile @relation(fields: [assignedById], references: [id])\\n}\\n\\nmodel StudentRemark {\\n  id         String   @id @default(uuid())\\n  studentId  String\\n  authorName String\\n  category   String\\n  comment    String\\n  createdAt  DateTime @default(now())\\n\\n  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)\\n}\\n\\nmodel Notice {\\n  id          String   @id @default(uuid())\\n  instituteId String\\n  authorId    String\\n  title       String\\n  content     String\\n  targetRole  Role?\\n  createdAt   DateTime @default(now())\\n\\n  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)\\n  author      User      @relation(\\\"NoticeAuthor\\\", fields: [authorId], references: [id])\\n}\\n\\nmodel Notification {\\n  id        String   @id @default(uuid())\\n  userId    String\\n  title     String\\n  body      String\\n  link      String?\\n  isRead    Boolean  @default(false)\\n  createdAt DateTime @default(now())\\n\\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\\n}\"\n  },\n  \"authentication_and_rbac\": {\n    \"rbac_matrix\": {\n      \"SUPER_ADMIN\": [\"institute:write\", \"analytics:global\", \"branch:manage\", \"billing:manage\", \"staff:manage\", \"students:manage\", \"notices:publish\"],\n      \"ADMIN\": [\"staff:manage\", \"students:manage\", \"batches:manage\", \"fees:manage\", \"timetable:manage\", \"reports:generate\", \"notices:publish\"],\n      \"TEACHER\": [\"attendance:mark\", \"marks:entry\", \"homework:create\", \"improvement_plan:manage\", \"remarks:create\", \"analytics:batch\"],\n      \"STUDENT\": [\"self_profile:view\", \"attendance:view\", \"results:view\", \"homework:submit\", \"timetable:view\", \"goals:view\"],\n      \"PARENT\": [\"child_profile:view\", \"child_attendance:view\", \"child_results:view\", \"fees:view_pay\", \"feedback:submit\"]\n    },\n    \"jwt_payload_structure\": {\n      \"sub\": \"user_uuid\",\n      \"instituteId\": \"institute_uuid\",\n      \"role\": \"SUPER_ADMIN | ADMIN | TEACHER | STUDENT | PARENT\",\n      \"email\": \"user@ims.edu\",\n      \"profileId\": \"profile_uuid_or_null\",\n      \"iat\": 1700000000,\n      \"exp\": 1700086400\n    },\n    \"middleware_logic_pseudocode\": \"export async function middleware(req: NextRequest) {\\n  const token = req.cookies.get(\'token\')?.value || req.headers.get(\'Authorization\')?.replace(\'Bearer \', \'\');\\n  if (!token) return NextResponse.json({ error: \'Unauthenticated\' }, { status: 401 });\\n  try {\\n    const payload = verifyJWT(token);\\n    const { pathname } = req.nextUrl;\\n    if (pathname.startsWith(\'/api/admin\') && ![\'SUPER_ADMIN\', \'ADMIN\'].includes(payload.role)) {\\n      return NextResponse.json({ error: \'Forbidden\' }, { status: 403 });\\n    }\\n    if (pathname.startsWith(\'/api/teacher\') && ![\'SUPER_ADMIN\', \'ADMIN\', \'TEACHER\'].includes(payload.role)) {\\n      return NextResponse.json({ error: \'Forbidden\' }, { status: 403 });\\n    }\\n    const requestHeaders = new Headers(req.headers);\\n    requestHeaders.set(\'x-user-id\', payload.sub);\\n    requestHeaders.set(\'x-institute-id\', payload.instituteId);\\n    requestHeaders.set(\'x-user-role\', payload.role);\\n    return NextResponse.next({ request: { headers: requestHeaders } });\\n  } catch (err) {\\n    return NextResponse.json({ error: \'Invalid or expired token\' }, { status: 401 });\\n  }\\n}\"\n  },\n  \"api_endpoints\": [\n    {\n      \"group\": \"Authentication\",\n      \"routes\": [\n        { \"method\": \"POST\", \"path\": \"/api/auth/login\", \"auth\": false, \"roles\": [\"ALL\"], \"description\": \"Authenticates credentials and returns JWT plus role profile context.\" },\n        { \"method\": \"GET\", \"path\": \"/api/auth/me\", \"auth\": true, \"roles\": [\"ALL\"], \"description\": \"Retrieves currently logged in user context and linked entity profile.\" },\n        { \"method\": \"POST\", \"path\": \"/api/auth/logout\", \"auth\": true, \"roles\": [\"ALL\"], \"description\": \"Clears auth cookies and invalidates session token.\" }\n      ]\n    },\n    {\n      \"group\": \"Institute Management & Batches\",\n      \"routes\": [\n        { \"method\": \"GET\", \"path\": \"/api/courses\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"List all courses with linked subjects.\" },\n        { \"method\": \"POST\", \"path\": \"/api/courses\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Create course with subject catalog.\" },\n        { \"method\": \"GET\", \"path\": \"/api/batches\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"List batches with student count and subject-teacher mapping.\" },\n        { \"method\": \"POST\", \"path\": \"/api/batches\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Create new batch and assign course.\" }\n      ]\n    },\n    {\n      \"group\": \"Student & Staff Management\",\n      \"routes\": [\n        { \"method\": \"GET\", \"path\": \"/api/students\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Paginated search & filter of students by batch, status, and search query.\" },\n        { \"method\": \"POST\", \"path\": \"/api/students\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Enroll a student, create user record, link to batch & guardian.\" },\n        { \"method\": \"GET\", \"path\": \"/api/students/:id/profile\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"], \"description\": \"Returns full 360-degree student performance snapshot and timeline.\" },\n        { \"method\": \"GET\", \"path\": \"/api/teachers\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"List all teacher profiles, active batches, and assigned subjects.\" }\n      ]\n    },\n    {\n      \"group\": \"Attendance\",\n      \"routes\": [\n        { \"method\": \"POST\", \"path\": \"/api/attendance/mark\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Bulk submit attendance for an entire batch for a specified date.\" },\n        { \"method\": \"GET\", \"path\": \"/api/attendance/batch/:batchId\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Get date-wise batch attendance matrix.\" },\n        { \"method\": \"GET\", \"path\": \"/api/attendance/student/:studentId\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"], \"description\": \"Get student attendance percentage, daily list, and streaks.\" }\n      ]\n    },\n    {\n      \"group\": \"Exams & Results\",\n      \"routes\": [\n        { \"method\": \"POST\", \"path\": \"/api/tests\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Schedule a test for a batch with subject and maximum marks.\" },\n        { \"method\": \"POST\", \"path\": \"/api/tests/:testId/marks\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Enter and commit marks for all students in the test.\" },\n        { \"method\": \"GET\", \"path\": \"/api/tests/batch/:batchId\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Fetch test list with average performance statistics.\" }\n      ]\n    },\n    {\n      \"group\": \"Analytics & Performance Engine\",\n      \"routes\": [\n        { \"method\": \"GET\", \"path\": \"/api/analytics/institute-summary\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Aggregate KPI stats: total admissions, collections, attendance rate, at-risk flags.\" },\n        { \"method\": \"GET\", \"path\": \"/api/analytics/student/:studentId/intelligence\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\", \"STUDENT\", \"PARENT\"], \"description\": \"Calculates subject strengths, weak spots, trajectory curves, and automated improvement tasks.\" },\n        { \"method\": \"POST\", \"path\": \"/api/analytics/improvement-plans\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\", \"TEACHER\"], \"description\": \"Create remediation target plan for a weak student.\" }\n      ]\n    },\n    {\n      \"group\": \"Fee Operations\",\n      \"routes\": [\n        { \"method\": \"GET\", \"path\": \"/api/fees/invoices\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"List fee invoices with status, overdue counts, and date filters.\" },\n        { \"method\": \"POST\", \"path\": \"/api/fees/collect\", \"auth\": true, \"roles\": [\"SUPER_ADMIN\", \"ADMIN\"], \"description\": \"Record manual or offline fee collection against an invoice.\" }\n      ]\n    }\n  ],\n  \"page_and_screen_hierarchy\": {\n    \"SUPER_ADMIN\": {\n      \"web_routes\": [\n        { \"path\": \"/super-admin/dashboard\", \"title\": \"Executive Overview\", \"widgets\": [\"Institute KPI Strip\", \"Enrollment vs Dropout Line Chart\", \"Revenue Collections Bar Chart\", \"Academic Health Index Heatmap\"] },\n        { \"path\": \"/super-admin/institutes\", \"title\": \"Branches & Settings\", \"widgets\": [\"Branch Selector\", \"Global Plan Limits\", \"API Webhook Integrations\"] },\n        { \"path\": \"/super-admin/audit-logs\", \"title\": \"System Audit Trail\", \"widgets\": [\"Realtime Action Logs\", \"Security Auth Exceptions\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"SuperAdminOverviewScreen\", \"title\": \"IMS Executive Mobile\", \"components\": [\"SummaryCards\", \"QuickRevenueWidget\", \"EmergencyNoticeDispatcher\"] }\n      ]\n    },\n    \"ADMIN\": {\n      \"web_routes\": [\n        { \"path\": \"/admin/dashboard\", \"title\": \"Operations Dashboard\", \"widgets\": [\"Today\'s Attendance Rate\", \"Active Batches\", \"Fee Dues Pending\", \"High Priority At-Risk Alerts\"] },\n        { \"path\": \"/admin/students\", \"title\": \"Student Directory\", \"widgets\": [\"Data Table with Multi-Filter\", \"Batch Transfer Modal\", \"Admission Wizard Button\"] },\n        { \"path\": \"/admin/teachers\", \"title\": \"Faculty Management\", \"widgets\": [\"Workload Distribution Cards\", \"Teacher Subject Mapping Table\"] },\n        { \"path\": \"/admin/batches\", \"title\": \"Batch & Timetable Manager\", \"widgets\": [\"Weekly Scheduler Matrix\", \"Capacity Utilization Gauges\"] },\n        { \"path\": \"/admin/fees\", \"title\": \"Fee Management Hub\", \"widgets\": [\"Defaulter List Table\", \"Payment Collection Drawer\", \"Aging Report Chart\"] },\n        { \"path\": \"/admin/notices\", \"title\": \"Notice Board Center\", \"widgets\": [\"Composer with Role Target Selector\", \"Published Circulars Feed\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"AdminDashboardScreen\", \"title\": \"Ops Hub\", \"components\": [\"AttendanceDonut\", \"DefaulterQuickStrip\", \"RecentAdmissionsList\"] },\n        { \"screen\": \"AdminStudentListScreen\", \"title\": \"Find Student\", \"components\": [\"FastSearchInput\", \"StudentMiniCardWithPhoneDial\"] }\n      ]\n    },\n    \"TEACHER\": {\n      \"web_routes\": [\n        { \"path\": \"/teacher/dashboard\", \"title\": \"Teacher Workspace\", \"widgets\": [\"Today\'s Schedule Cards\", \"Pending Homework Grading\", \"Weak Student Radar Alert\"] },\n        { \"path\": \"/teacher/attendance\", \"title\": \"Daily Roll Call\", \"widgets\": [\"Batch Dropdown\", \"Fast One-Click Present/Absent/Late Toggles\", \"Streak Auto-Calculator\"] },\n        { \"path\": \"/teacher/marks\", \"title\": \"Gradebook & Test Entry\", \"widgets\": [\"Test Creator Drawer\", \"Bulk Marks Input Spreadsheet Grid\", \"Live Bell-Curve Distribution Chart\"] },\n        { \"path\": \"/teacher/homework\", \"title\": \"Homework Assignments\", \"widgets\": [\"Assignment Creator Form\", \"Submission Review List with Grade Input\"] },\n        { \"path\": \"/teacher/remediation\", \"title\": \"Intervention & Improvement\", \"widgets\": [\"AI Suggested Remediation Plans\", \"Task Assignment Checklist\", \"Parent Note Composer\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"TeacherAttendanceScreen\", \"title\": \"Quick Roll Call\", \"components\": [\"FastSwipeableStudentCards\", \"SubmitAttendanceFloatingButton\"] },\n        { \"screen\": \"TeacherGradeEntryScreen\", \"title\": \"Enter Test Marks\", \"components\": [\"CompactMarkInputRow\", \"ClassAverageLiveBadge\"] }\n      ]\n    },\n    \"STUDENT\": {\n      \"web_routes\": [\n        { \"path\": \"/student/dashboard\", \"title\": \"Student Learning Dashboard\", \"widgets\": [\"Academic Streak Counter\", \"Upcoming Tests & Timetable\", \"Subject Mastery Radial Progress\", \"Recent Badges Won\"] },\n        { \"path\": \"/student/performance\", \"title\": \"My Performance Analytics\", \"widgets\": [\"Score Growth Trajectory Line Chart\", \"Class vs Self Comparison Bar Chart\", \"Subject Weakness Drilldown\"] },\n        { \"path\": \"/student/homework\", \"title\": \"Homework & Tasks\", \"widgets\": [\"Pending Homework Kanban\", \"Document Upload Form\", \"Past Grades & Teacher Feedback\"] },\n        { \"path\": \"/student/timeline\", \"title\": \"My Journey Timeline\", \"widgets\": [\"Chronological Feed of Test Scores, Awards, Remarks and Badges\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"StudentHomeScreen\", \"title\": \"Student Pulse\", \"components\": [\"StreakFireWidget\", \"TodayClassList\", \"SubjectMasteryBars\"] },\n        { \"screen\": \"StudentResultsScreen\", \"title\": \"Report Card\", \"components\": [\"ScoreTrendChart\", \"RecentExamAccordion\"] }\n      ]\n    },\n    \"PARENT\": {\n      \"web_routes\": [\n        { \"path\": \"/parent/dashboard\", \"title\": \"Ward Overview\", \"widgets\": [\"Attendance Rate Gauge\", \"Latest Exam Grades\", \"Teacher Remarks Feed\", \"Fee Invoices Due Notification\"] },\n        { \"path\": \"/parent/reports\", \"title\": \"Child Academic Diagnostics\", \"widgets\": [\"Plain-English Summary Card\", \"Subject Confidence Level Chart\", \"Remediation Action Items Assigned to Child\"] },\n        { \"path\": \"/parent/fees\", \"title\": \"Fee Ledger\", \"widgets\": [\"Pending Invoices Table\", \"Receipt Downloader Button\"] }\n      ],\n      \"mobile_screens\": [\n        { \"screen\": \"ParentOverviewScreen\", \"title\": \"Ward Progress\", \"components\": [\"ChildProfileHeader\", \"AttendanceMiniDial\", \"ExamScoreCard\", \"PayFeeStickyBar\"] }\n      ]\n    }\n  },\n  \"ui_component_library\": {\n    \"components\": [\n      {\n        \"name\": \"StatCard\",\n        \"props\": [\"title: string\", \"value: string | number\", \"change: number\", \"trend: \'up\' | \'down\' | \'neutral\'\", \"icon: LucideIcon\", \"accentColor?: string\"],\n        \"description\": \"Renders high-level KPI card with change metric indicator and colored badge.\"\n      },\n      {\n        \"name\": \"PerformanceTrendChart\",\n        \"props\": [\"data: Array<{ testName: string, studentScore: number, classAverage: number }>\", \"height?: number\"],\n        \"description\": \"Dual-line interactive Recharts component showing individual progression compared against class mean.\"\n      },\n      {\n        \"name\": \"AttendanceHeatmap\",\n        \"props\": [\"records: Array<{ date: string, status: \'PRESENT\' | \'ABSENT\' | \'LATE\' | \'EXCUSED\' }>\"],\n        \"description\": \"GitHub-style month-by-month square activity matrix visualizing student presence.\"\n      },\n      {\n        \"name\": \"AtRiskBadge\",\n        \"props\": [\"severity: \'LOW\' | \'MEDIUM\' | \'HIGH\' | \'CRITICAL\'\", \"category: string\"],\n        \"description\": \"Pulsing tag component that draws immediate faculty attention to struggling or chronically absent students.\"\n      },\n      {\n        \"name\": \"FastAttendanceGrid\",\n        \"props\": [\"students: Student[]\", \"initialStatus?: Record<string, \'PRESENT\'|\'ABSENT\'|\'LATE\'>\", \"onSave: (records: Record<string, string>) => void\"],\n        \"description\": \"Optimized batch attendance taker with keyboard navigation, hotkeys (P/A/L), and multi-select toggles.\"\n      },\n      {\n        \"name\": \"BadgeShowcase\",\n        \"props\": [\"badges: Array<{ id: string, name: string, earnedAt: string, icon: string, description: string }>\"],\n        \"description\": \"Gamification widget displaying earned academic milestones, attendance streaks, and rank badges.\"\n      }\n    ]\n  },\n  \"performance_engine_algorithms\": {\n    \"rules\": {\n      \"low_attendance_threshold_percentage\": 75.0,\n      \"academic_drop_threshold_percentage\": 15.0,\n      \"homework_consecutive_misses_limit\": 3\n    },\n    \"analytics_service_implementation_ts\": \"export interface StudentDiagnosticResult {\\n  studentId: string;\\n  overallAverage: number;\\n  classAverageDelta: number;\\n  attendanceRate: number;\\n  subjectWeaknesses: Array<{ subject: string; average: number; targetGap: number }>;\\n  subjectStrengths: Array<{ subject: string; average: number }>;\\n  flags: Array<{\\n    category: \'ATTENDANCE\' | \'ACADEMIC_DROP\' | \'HOMEWORK\' | \'CHRONIC_WEAKNESS\';\\n    severity: \'LOW\' | \'MEDIUM\' | \'HIGH\' | \'CRITICAL\';\\n    message: string;\\n  }>;\\n  automatedRecommendations: string[];\\n}\\n\\nexport function computeStudentDiagnostics(\\n  studentTests: Array<{ subjectName: string; marksObtained: number; maxMarks: number; testDate: Date; classAveragePct: number }>,\\n  attendanceRecords: Array<{ status: \'PRESENT\' | \'ABSENT\' | \'LATE\' | \'EXCUSED\' }>,\\n  pendingHomeworkCount: number\\n): StudentDiagnosticResult {\\n  const flags: StudentDiagnosticResult[\'flags\'] = [];\\n  const recommendations: string[] = [];\\n\\n  // 1. Attendance Analysis\\n  const totalSessions = attendanceRecords.length;\\n  const presentCount = attendanceRecords.filter(r => r.status === \'PRESENT\' || r.status === \'LATE\').length;\\n  const attendanceRate = totalSessions > 0 ? (presentCount / totalSessions) * 100 : 100;\\n\\n  if (attendanceRate < 75.0) {\\n    flags.push({\\n      category: \'ATTENDANCE\',\\n      severity: attendanceRate < 60.0 ? \'CRITICAL\' : \'HIGH\',\\n      message: `Attendance is dangerously low at ${attendanceRate.toFixed(1)}%. Missed lessons directly impact upcoming exams.`\\n    });\\n    recommendations.push(\'Schedule mandatory parental counseling regarding classroom absenteeism.\');\\n  }\\n\\n  // 2. Subject Breakdown\\n  const subjectMap = new Map<string, { totalPct: number; count: number; recentScores: number[] }>();\\n  for (const t of studentTests) {\\n    const pct = (t.marksObtained / t.maxMarks) * 100;\\n    const existing = subjectMap.get(t.subjectName) || { totalPct: 0, count: 0, recentScores: [] };\\n    existing.totalPct += pct;\\n    existing.count += 1;\\n    existing.recentScores.push(pct);\\n    subjectMap.set(t.subjectName, existing);\\n  }\\n\\n  const subjectWeaknesses: StudentDiagnosticResult[\'subjectWeaknesses\'] = [];\\n  const subjectStrengths: StudentDiagnosticResult[\'subjectStrengths\'] = [];\\n  let sumAverages = 0;\\n\\n  subjectMap.forEach((val, subject) => {\\n    const avg = val.totalPct / val.count;\\n    sumAverages += avg;\\n\\n    if (avg < 50.0) {\\n      subjectWeaknesses.push({ subject, average: avg,"
    }
  }
}
