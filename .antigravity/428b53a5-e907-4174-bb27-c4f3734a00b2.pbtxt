              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const feeCollections = allFin.filter(x => x.category === \'Student fees\').reduce((a, b) => a + b.amount, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const otherCredits = allFin.filter(x => x.type === \'Credit\' && x.category !== \'Student fees\').reduce((a, b) => a + b.amount, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const totalExpenses = allFin.filter(x => x.type === \'Debit\').reduce((a, b) => a + b.amount, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const netOperating = feeCollections + otherCredits - totalExpenses;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
