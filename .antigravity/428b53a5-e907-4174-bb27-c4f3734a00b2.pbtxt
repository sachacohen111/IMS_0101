  planner_response {
    thinking: "**Connecting the Application**\n\nI\'m now focusing on connecting all the components within `/src/App.tsx`. I\'m starting by wiring the `IMSProvider`. My plan is to review the main views and tabs. Specifically, I\'m thinking about how the `MainContent` component will fit together, including the `TopHeader`, the 2-column body layout with the Sidebar and Main viewport, and the role.\n\n\n"
    tool_calls {
      id: "call_132197"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * @license\\n * SPDX-License-Identifier: Apache-2.0\\n */\\n\\nimport React, { useState, useEffect } from \'react\';\\nimport { IMSProvider, useIMS } from \'./context/IMSContext\';\\nimport { TopHeader } from \'./components/navigation/TopHeader\';\\nimport { Sidebar } from \'./components/navigation/Sidebar\';\\nimport { SuperAdminView } from \'./components/roles/SuperAdminView\';\\nimport { AdminView } from \'./components/roles/AdminView\';\\nimport { TeacherView } from \'./components/roles/TeacherView\';\\nimport { StudentView } from \'./components/roles/StudentView\';\\nimport { ParentView } from \'./components/roles/ParentView\';\\nimport { MobilePreviewModal } from \'./components/mobile/MobilePreviewModal\';\\n\\nconst MainLayout: React.FC = () => {\\n  const { role } = useIMS();\\n  const [currentTab, setCurrentTab] = useState<string>(\'dashboard\');\\n\\n  // Reset tab to dashboard when role is switched\\n  useEffect(() => {\\n    setCurrentTab(\'dashboard\');\\n  }, [role]);\\n\\n  const getSectionTitle = () => {\\n    switch (currentTab) {\\n      case \'dashboard\':\\n        return \'Overview\';\\n      case \'students\':\\n        return \'Student Directory\';\\n      case \'teachers\':\\n        return \'Faculty\';\\n      case \'batches\':\\n        return \'Batches & Timetable\';\\n      case \'fees\':\\n        return \'Fee Management\';\\n      case \'notices\':\\n        return \'Notice Center\';\\n      case \'attendance\':\\n        return \'Roll Call\';\\n      case \'marks\':\\n        return \'Gradebook & Exams\';\\n      case \'homework\':\\n        return \'Homework\';\\n      case \'remediation\':\\n        return \'Remediation Plans\';\\n      case \'performance\':\\n        return \'Analytics\';\\n      case \'timeline\':\\n        return \'Journey\';\\n      case \'reports\':\\n        return \'Diagnostics\';\\n      case \'institutes\':\\n        return \'Campuses\';\\n      case \'audit-logs\':\\n        return \'Audit Logs\';\\n      default:\\n        return \'Workspace\';\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#F8FAFC] dark:bg-[#0B1329] text-slate-900 dark:text-slate-100 flex flex-col font-sans transition-colors duration-200\\\">\\n      {/* 3-zone Header Contract */}\\n      <TopHeader currentSection={getSectionTitle()} />\\n\\n      {/* Main Workspace split */}\\n      <div className=\\\"flex-1 flex w-full\\\">\\n        {/* Role-Aware Sidebar */}\\n        <Sidebar currentTab={currentTab} onTabChange={setCurrentTab} />\\n\\n        {/* Viewport Content */}\\n        <main className=\\\"flex-1 p-6 max-w-7xl mx-auto w-full overflow-x-hidden\\\">\\n          {role === \'SUPER_ADMIN\' && <SuperAdminView currentTab={currentTab} />}\\n          {role === \'ADMIN\' && <AdminView currentTab={currentTab} />}\\n          {role === \'TEACHER\' && <TeacherView currentTab={currentTab} />}\\n          {role === \'STUDENT\' && <StudentView currentTab={currentTab} />}\\n          {role === \'PARENT\' && <ParentView currentTab={currentTab} />}\\n        </main>\\n      </div>\\n\\n      {/* Simulated React Native Expo Mobile Screen Modal */}\\n      <MobilePreviewModal />\\n    </div>\\n  );\\n};\\n\\nexport default function App() {\\n  return (\\n    <IMSProvider>\\n      <MainLayout />\\n    </IMSProvider>\\n  );\\n}\\n\", \"Description\":\"Connect top header, sidebar, role views, and mobile simulation in App.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Writing App.tsx\", \"toolSummary\":\"Assemble complete IMS application\"}"
      thinking_signature: "\022\364\n\n\361\n\001i\024}\023\003u\263_\005\322\001\335\254\305\272\0351\207WLu\325\272m\361\303\246\326\335\004\352\332s\223(e\323\225\233I\3500r\244\245\267\325\030i\023\0366\033\362l\343O\375c\353\212\377\031\276%F\2775\230\2717R\302\233(L\342\023\025\350[\341\265\227\354\215\021[\230\363\371wq\276\334\347[\016\357\022Q\2574\313}\223\036j\3651\254\023qT\037\346\373\212\210x]\205\353v\340\220g\306\355D\347,\035\036\237\354\335\033e\326\251\301\001\377\'3J\277Wu\032\330-\252\270\240\274UeN.\315\320\337\235\214b$\340tbF\257^G\362/\335\f;\263\217\241\321\2249\017\276Zv\213\vt\001\215\363\342\241;W{\222#\265\321\022\276\217\325\316y\260\230\252\002H\313i.\210\277\362\224\361d*\371n\376o\252\302\035\336hhW`\377\263\353g\347\t\203>\265\217g\337\027y\207lF\030\002\271\223KZF\000s4HnD\274\033\022\347\345oS\330Z\306\230x\323*\276\032\266U\205\330`P\"\326&\325D\3728/\304O\021\366.]\354\270\340.\233}\244r\204?\317\201[\177\340\224\271\347Lp\035p\t\177\304\274#\276\252@\320k\304\326Z(h\3565@\206N3\332`\024\022%j\003\325\263Se\031l\244\243\267\2237\367\367\210\356\027\263\rL\250\231\003\f\234\253LO\243`\004\021\'\334\304\361\376\314\372\016\314\214\241\"4\0059\2334\216\217Z\373\250\203\266\303E\2304`\320\344\372\314l\202\203\003dJ\343H\370hg\351\322\245\355\032\270A\233\265\304b\332\375\211X\363\2173\206\260p\370\242\325\303\v\207\224!a\247+Yf:\332\225\341{,\266n/\321\230\276\273Rs\242Wq6\n\267\260\005\301\001o\2502*c\024\271+\2123\001\021\272\347\255\021\2275\305\237\246\341\005`\315\303\340\002\371\250\363\213%\300K\'\217=hn\370,\265i\034\027`*\t5E\370\274n*\314\v`\0017*\254\307#\320\020\247\036\322e\033tb\3336\005`<\377\325\340]\0243\250\310\357\000\360\262d\"\316{\354\235\005C\371<\361\217{\303\2245\035I\366\346\3735\246c\371\346\'K\301W\356P\325\003\272\302k\312\337\264\307\354\340i\201\211\352\321\'\001D]W\016b>\241\037J\311\371\225V\206\205\205\315\273\276DD\235\332C\340\254\232(\363\343\2460N\221\234b\271\036Y\260\001(\033\363\366\f\227t\3