      thinking_signature: "\022\214\023\n\211\023\001i\024}\023\345\235\301\334JVM\271\340;=e\254\322\261.#\251\3239\177r\335\203=ML\321\272\324\306\301\374\251\031\305&\211\254%A\257X\377yS\336A\307d\354\372]\220\306XD\245T%\204\370\231\362\027\332\273\301\371\333\224\203\302\353\214\245\372JpqF\271\206\f\322\330\357\313\021\210\25514\032\344\242\362\247~\370j\311\371\267\371\216\025A\205D,\016c\250Y\026X:\025\004\2747\026\200?4>\261\240!T\237A\372\332o\300\325\237\300\223\026\332\3570\376\303\373\313\026wL\306+\301\375a$\252\276j@\361J\002\330k\370\340\224\207\367K\'\037\304.\323T\222\227\324m@b\031\363\021\017\242\340\352\241\234\351~g\325.\342\204_\223\377\262Vd\\\240/\277\300+\2735\033F\266)`34\022\302\266\277\341l\344\314\370\022\336V\304\214\255@\204\021\353b\204\255\237n8\241\260\374^\320F\231\a\027\022\a\252n\241\353/\'\222)\326\024\266O\323\355\331iqP?\034\352\"\211\277\313\330\f(\315bm\207\332-\217\231\036\366\027(\200\310X\037\270\351aGA\t\2516K\004K?\261\022\324\307\335m\263\005=\351\240\341l\336\265Q\332\352\221\203\356\214x\302\225c\310sX\030p5Zs\202\257d\034.\320\334#)\360\023\r\201?6\266\320\316\240\346\t;\370\231\213\201h\374\027\304\351\224\r\321\242\3600 \200?\3259\023\032\275|\r\"\204\207\322!\360\230\237\343J\302\241}\343\362X\rn\346F9\311\346\360m\312m\363\277&\265\023NS\267Lc$\203\240\354\004\210\341\214\f\230\305\3027e^!(\242\335\203\202u\271]\270\311\225\267\255\264\f\271\374Kk\262\252\206\024\032\020?\360\332/-\326\207\001uMu\227)\306\305\225\b\n\032\a\255ze\022\362\246\254\203Q\251.?\302\"*{8\236\222\035d\001<q\273\350t\027\v\374F\305\345\021\f_\025\001\001=:\'\330\245\237\363\256\005On_\026\211\242P\024\031\200\363\327\301T\264:\220\033\203\352\250\307\247\343\222\\\333\374~\354O.\355\264\341\263F\345\025\256\335=NN\333x\306w\272I\376\374\312\343s\242J%\340\205wnc3s\333\304\315\363\031\231\027\270@\227l\363BY^\320\236Gx?\307f\347!\345#\276\017\\\202\253\006\300\330\213?\0374<\327\a\202\360I\363\320\267\374\323\366\217\317$\311\356\226\22