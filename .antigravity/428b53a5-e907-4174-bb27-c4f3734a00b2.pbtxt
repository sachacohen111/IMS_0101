      thinking_signature: "\022\306\n\n\303\n\001i\024}\023%\346u\217^4\fP\260\333\303\006\323[\2003\277\b\r\016\323\370d\375fz\t\313m\306\342\227\024\330\376\037\200u\342V\321SXl$\356\000\345\300\234x\"\212,\235\302-\257>\217C\247\321\3476\330\272\233\020X\006i\3201*\230\266V\352e6\332t\356\v\276\232\236y\264S\001\221\231;\245Hb\235B\234\326\313\314\373\326\235F\2453\312h\251\370\bD\024\313yJUR\224^P\376\036\332vKN\027\241\316\301\035g\264_\322\346\304:\323\313;\202\3200\215[\256\203:\340\266\023}F\376B\v\275B\235\244;\030f\036\205\374\027\234\222~\035Zq\200O\rVD\367\261\374\"\373l7\245\370\240\234R\213\017\0325;\310\023\341\315]\303\326\336L3\036B\340W@\212{\366\2709n\234\002\217\252l\251]\307\210\025\261\037l\306|\rp\237\021\345\227\232\032:j\341+f\365\3441\207\277\236\372\223O\222\252\271\005V7)\262\220\322\2113\023\253\240\2728q]\302\306\356\344\203\270\261k\340\'%\\\017\325r&:e#\347\255D\344^6\304u\372\314\031,`+\275D\037\016\301Sk\313|\332\212\333\035\235\247\327SZ\001\201%\005\"p\323S ]Z\251\340\272P\267\222\313\036\370f\301\256p\037\376Q\277\364!\241\366\276V\261\251\217c.\031N\277\3140~\355p\335r\234\373\225j91\231\251Kr+:]cV\316\224\262\336\207\375\253\004\302\320c\364S[\210\364p\320\345{\313\336\254\241\277o\004\336\314Xi\275G|R\343\n:Y\221\326\232\v\223E\235e\\\"\034\317`i\005M\275\256c\n\247-\357\325&2\252\311\313TW\204\032\327\271 \213\257\035I\036@\255\266\322\356x\235p\006\267\006>\177\365i\373\226\271d\"L(hI}\315!\250\344`\t.\rs\274\344\206\203\024\215\0254\002\320\"Z\211\220xE\301EU.\231\241\372\246\001\024W\367\016\232\225_,\236\305YJ\337\004\357\305\036\32639;a\376\243\317\357\351\236\022\252\204\361 \305E\301\337\243\t\022\252J\273\372du\262r{\030\375\346m\023\027\231\354w\237\321\257\225\024\'\033\210\212\350\377\311\302\002\222\224\355V\3063>R^6\332\3727\252\350\323>\031M\353a\305b\350\276\346{\222\005\331J\036\341\232g\367\277%bG\366\241\221\260\273\310\274_3\273\226\230D\346\320\353F\247\261\312gj\212\224\203X\016\250C:\226\314\367u {\271\374\275W\335F\3642\275\245 \2036\322@\231j\035\340\343\021Z\302Z|%\200\246\v\035\r\021\224\232\256\333rF\272m\315a03\023\263=\334/#M>*9\226\233_EFz\3735\233*\254\346\253\341\321Ic\017\r\020\006\025g\310zJD\264\224\315\266\t\332\337\223S\3453\315\001\352F\271\344\'\266\314\376\r\227\220\227\016\350\262\203C\250\365\274_i\225\003\336j\364c\325\211\3545\252+L\207U\033\322D\300R\215?\372\266\352\351\n2\373\017\347\206\253DQ\300\n\327\377\234Vk\272\213\332\001\315\337z\024\000\206\257.\330y=[\233N{\231_\334\206{\262R\231\nT\307X!Zr\213\344\205\v\266\364\362\313\027\336h\3635\332\302\276\3108\272?C\271m\005\242\214\237tp\354\'jGi\340\000\264\276\237\227\322\031b\023\212\255IM/0\247,\256S\341\206O\021F\'g9\241\312Z*\350V\342\312i\3219\375H\243={\225\316\276\210\022\247\313P\305C\0014\3736\205\216<S7\032f\337\265=\333\257o\310\335\206\264_\271\027_\226e\b!5\247\364\212>\377.\2170\354\210!x\261.\341\216\236\214X\334\032\247,\223\300\251\000^q\271\025\250\337\271a7\327\312b\034J~\303Z\327E3\006\002\326\017\220\204pu\252A\2477\214\020\026Y\343\277\341\313\317\220=B\340\251\177\323\034\222\272\267\323:\023\336\246\354\213\347\322[\006fw\317\347\270\303\036\270f\200\333\224\a\352\306\373\202_D\003%\333\346\227bGd\313\025,\250m\214\273\240?\245n/\016n\271\321{?\034\375\364$^(\244{T\317\334\330F\240\2514\323tj\017[\213\005P\370\203\3432\335sG\374\311\230\355Pr\367\204`\236\016\222E!\256(\257\371\234R-t\331\233^\310a\017\252\036\244\216\036\254V\030\273\233\230-\3318\312\357\315\301QqG\225\267\226\\k\002\255\3216,\344\204N.N\220-\344\367&fuE\026\221R\r\333\214Q\355G\261\264i\263j|VeR\313K\224\373\324\371uQ\274\236%D$\235:d\325-\315JX\322\347\205:\0171`C4\307NwK\377\355\232\025\202\314\360\t_\020\'\322:\212P\337\317\023R.\222%i!\202R#\301\026\356\361\232\003\241/\222dd\254r\037\277\032\226\227(aVO\312\020\\pG\271\353\266\206\365%CY"
