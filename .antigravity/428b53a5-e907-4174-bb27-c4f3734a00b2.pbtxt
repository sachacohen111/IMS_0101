  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 95
    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect } from \'react\';\nimport { IMSProvider, useIMS } from \'./context/IMSContext\';\nimport { TopHeader } from \'./components/navigation/TopHeader\';\nimport { Sidebar } from \'./components/navigation/Sidebar\';\nimport { SuperAdminView } from \'./components/roles/SuperAdminView\';\nimport { AdminView } from \'./components/roles/AdminView\';\nimport { TeacherView } from \'./components/roles/TeacherView\';\nimport { StudentView } from \'./components/roles/StudentView\';\nimport { ParentView } from \'./components/roles/ParentView\';\nimport { MobilePreviewModal } from \'./components/mobile/MobilePreviewModal\';\n\nconst MainLayout: React.FC = () => {\n  const { role } = useIMS();\n  const [currentTab, setCurrentTab] = useState<string>(\'dashboard\');\n\n  // Reset tab to dashboard when role is switched\n  useEffect(() => {\n    setCurrentTab(\'dashboard\');\n  }, [role]);\n\n  const getSectionTitle = () => {\n    switch (currentTab) {\n      case \'dashboard\':\n        return \'Overview\';\n      case \'students\':\n        return \'Student Directory\';\n      case \'teachers\':\n        return \'Faculty\';\n      case \'batches\':\n        return \'Batches & Timetable\';\n      case \'fees\':\n        return \'Fee Management\';\n      case \'notices\':\n        return \'Notice Center\';\n      case \'attendance\':\n        return \'Roll Call\';\n      case \'marks\':\n        return \'Gradebook & Exams\';\n      case \'homework\':\n        return \'Homework\';\n      case \'remediation\':\n        return \'Remediation Plans\';\n      case \'performance\':\n        return \'Analytics\';\n      case \'timeline\':\n        return \'Journey\';\n      case \'reports\':\n        return \'Diagnostics\';\n      case \'institutes\':\n        return \'Campuses\';\n      case \'audit-logs\':\n        return \'Audit Logs\';\n      default:\n        return \'Workspace\';\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#F8FAFC] dark:bg-[#0B1329] text-slate-900 dark:text-slate-100 flex flex-col font-sans transition-colors duration-200\">\n      {/* 3-zone Header Contract */}\n      <TopHeader currentSection={getSectionTitle()} />\n\n      {/* Main Workspace split */}\n      <div className=\"flex-1 flex w-full\">\n        {/* Role-Aware Sidebar */}\n        <Sidebar currentTab={currentTab} onTabChange={setCurrentTab} />\n\n        {/* Viewport Content */}\n        <main className=\"flex-1 p-6 max-w-7xl mx-auto w-full overflow-x-hidden\">\n          {role === \'SUPER_ADMIN\' && <SuperAdminView currentTab={currentTab} />}\n          {role === \'ADMIN\' && <AdminView currentTab={currentTab} />}\n          {role === \'TEACHER\' && <TeacherView currentTab={currentTab} />}\n          {role === \'STUDENT\' && <StudentView currentTab={currentTab} />}\n          {role === \'PARENT\' && <ParentView currentTab={currentTab} />}\n        </main>\n      </div>\n\n      {/* Simulated React Native Expo Mobile Screen Modal */}\n      <MobilePreviewModal />\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <IMSProvider>\n      <MainLayout />\n    </IMSProvider>\n  );\n}\n"
    num_lines: 96
    num_bytes: 3037
    line_range_bytes: 3037
  }
}
